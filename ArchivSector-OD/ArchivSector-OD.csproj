<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
		<RootNamespace>ArchivSector_OD</RootNamespace>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>AppIcon.ico</ApplicationIcon>

		<!-- Version shown in the .exe's Properties → Details tab -->
		<Version>3.9.95</Version>

		<!-- Only include English resource files, which drops the cs, de,
		     fr, ja, etc. language folders from the build/publish output -->
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
	</PropertyGroup>

	<!-- Release builds only: don't produce a .pdb debug file. Debug
	     builds still get one, so debugging in Visual Studio is unchanged. -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<DebugType>none</DebugType>
	</PropertyGroup>

	<ItemGroup>
		<!-- v4.0 beta 5: .NET 10 (long-term support until November 2028;
		     .NET 8's support ended on 10 November 2026). -->
		<PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.70" />
		<!-- Beta 4: Windows' own audio decoders (Media Foundation) for Music
		     CD mode's FLAC / MP3 / M4A / WMA files. NAudio.Wasapi holds the
		     Media Foundation reader and resampler; NAudio.Core comes with it. -->
		<PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
	</ItemGroup>

	<!-- Burning engine (IMAPI2 wrapper). Lives in its own project so a
	     standalone burner could reuse it later. -->
	<ItemGroup>
		<ProjectReference Include="..\ArchivSector-OD.Burning\ArchivSector-OD.Burning.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
		<None Update="AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
