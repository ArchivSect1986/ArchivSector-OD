@* Burning an ISO to a blank disc, shown inside a drive bay (v3.3), with
   ArchivSector-OD's own writer (the default from v4.0), ImgBurn or
   Windows' built-in burning engine (the user picks; remembered). A disc
   the own writer doesn't handle gets ImgBurn (or Windows) instead. The bay
   gets the blank disc's details from AppShell's drive polling
   (BurnService.QueryBlank); all the work is in BurnService. BusyChanged
   tells the bay while a burn runs. *@

@using System.IO
@using ArchivSector_OD.Burning
@using System.Windows
@implements IDisposable

@if (state == State.Idle && !string.IsNullOrEmpty(BlankMediaType))
{
    <div class="bay-status" style="flex-direction: column; align-items: stretch; gap: 6px; margin-top: 6px;">
        <span>💿 <strong>Blank @BlankMediaType</strong> in the drive — @DiscHealthService.FormatBytes(DiscBytes) (@DiscBytes.ToString("N0") bytes)</span>
        @if (DiscBytes > BlankFreeBytes)
        {
            <span class="bay-subtitle" style="margin: 0;">Windows' burning engine keeps @(DiscHealthService.FormatBytes(DiscBytes - BlankFreeBytes)) of it spare and can write @DiscHealthService.FormatBytes(BlankFreeBytes); ArchivSector-OD's own writer and ImgBurn use the whole disc.</span>
        }
        <button class="bay-btn game" @onclick="ChooseIso" disabled="@Disabled">@BurnButtonText</button>
    </div>
}
else if (state == State.Confirm && isoPath is not null)
{
    <div class="bay-status" style="flex-direction: column; align-items: stretch; gap: 8px; margin-top: 6px;">
        <strong>🔥 Burn to @BlankMediaType</strong>
        <span style="overflow-wrap: anywhere;">@Path.GetFileName(isoPath)</span>
        @if (cue is not null)
        {
            <span class="bay-subtitle" style="margin: 0;">@CueLine</span>
        }
        @if (CueProblem is not null)
        {
            <span style="color: var(--amber); font-size: 12px;">⚠ @CueProblem</span>
        }
        <span class="bay-subtitle" style="margin: 0;">
            @DiscHealthService.FormatBytes(isoBytes) of @DiscHealthService.FormatBytes(Limit)
            (@(Limit > 0 ? (100.0 * isoBytes / Limit).ToString("0.0") : "?")% of what @EngineName can write)
        </span>
        @if (TooBigForWindows && !TooBigForDisc && !useDirect && !useImgBurn && (DirectAvailable || imgBurnPath is not null))
        {
            <span style="color: var(--amber); font-size: 12px;">⚠ Windows' burning engine can only write @DiscHealthService.FormatBytes(BlankFreeBytes) to this disc. Choose @WholeDiscWriterName below to burn this ISO.</span>
        }
        else if (TooBigForWindows && !TooBigForDisc && !useDirect && !useImgBurn)
        {
            <span style="color: var(--danger); font-size: 12px;">⚠ Windows' burning engine can only write @DiscHealthService.FormatBytes(BlankFreeBytes) to this disc. Install ImgBurn to use the whole disc, or pick a smaller ISO.</span>
        }
        else if (TooBigForDisc)
        {
            <span style="color: var(--danger); font-size: 12px;">⚠ This image is bigger than the disc. Pick a smaller one or a bigger disc.</span>
        }
        <div style="display: flex; flex-direction: column; gap: 4px; font-size: 13px;">
            <span>Burn with:</span>
            <label style="display: flex; gap: 8px; align-items: center; cursor: @(DirectAvailable ? "pointer" : "default"); opacity: @(DirectAvailable ? "1" : "0.5");"
                   title="ArchivSector-OD writes the disc itself, talking to the drive directly: CD-R/RW, DVD±R, DVD±RW, DVD+R DL, BD-R and BD-RE.">
                <input type="radio" name="engine-@DriveLetter" checked="@useDirect" disabled="@(!DirectAvailable)" @onchange="() => Pick(BurnService.Writer.Own)" />
                ArchivSector-OD's own writer @DirectLabel
            </label>
            <label style="display: flex; gap: 8px; align-items: center; cursor: @(imgBurnPath is null ? "default" : "pointer"); opacity: @(imgBurnPath is null ? "0.5" : "1");"
                   title="@(imgBurnPath ?? "ImgBurn wasn't found. Install it, or set where it is in Settings.")">
                <input type="radio" name="engine-@DriveLetter" checked="@(useImgBurn && !useDirect)" disabled="@(imgBurnPath is null)" @onchange="() => Pick(BurnService.Writer.ImgBurn)" />
                ImgBurn @(imgBurnPath is null ? "(not installed)" : "(opens its own window with its progress)")
            </label>
            <label style="display: flex; gap: 8px; align-items: center; cursor: @(IsCue ? "default" : "pointer"); opacity: @(IsCue ? "0.5" : "1");">
                <input type="radio" name="engine-@DriveLetter" checked="@(!useImgBurn && !useDirect)" disabled="@IsCue" @onchange="() => Pick(BurnService.Writer.Windows)" />
                Windows @WindowsLabel
            </label>
            @if (engineNote is not null)
            {
                <span class="bay-subtitle" style="margin: 0; font-size: 12px;">ℹ @engineNote</span>
            }
            else if (useDirect)
            {
                <span class="bay-subtitle" style="margin: 0; font-size: 12px;">@FallbackNote</span>
            }
        </div>
        <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap; font-size: 13px;">
            <span>Speed:</span>
            @if (speedsLoading)
            {
                <span class="bay-subtitle" style="margin: 0;">checking what the drive offers…</span>
            }
            else if (speeds.Count > 1)
            {
                <select value="@SpeedKey(speedX)" @onchange="OnSpeedChanged" style="font-size: 13px;">
                    <option value="0">Fastest (@speeds[0].Label)</option>
                    @foreach (var sp in speeds.Skip(1))
                    {
                        <option value="@SpeedKey(sp.X)">@sp.Label</option>
                    }
                </select>
                @if (speedX > 0 && !useDirect && !useImgBurn)
                {
                    <span class="bay-subtitle" style="margin: 0; font-size: 12px;">@WindowsSpeedNote</span>
                }
            }
            else if (speeds.Count == 1)
            {
                <strong>@speeds[0].Label</strong>
                <span class="bay-subtitle" style="margin: 0; font-size: 12px;">@OnlySpeedNote</span>
            }
            else
            {
                <span class="bay-subtitle" style="margin: 0;">@NoSpeedsNote</span>
            }
        </div>
        <label style="display: flex; gap: 8px; align-items: center; cursor: pointer; font-size: 13px;">
            <input type="checkbox" checked="@verify" @onchange="e => verify = (bool)(e.Value ?? false)" />
            Verify after burning (reads the disc back and compares every byte, recommended)
        </label>
        <label style="display: flex; gap: 8px; align-items: center; cursor: @(verify ? "pointer" : "default"); font-size: 13px; opacity: @(verify ? "1" : "0.5");"
               title="Only after the disc was verified and every byte matched. You can restore it from the Recycle Bin.">
            <input type="checkbox" checked="@(deleteIso && verify && !IsCue)" disabled="@(!verify || IsCue)" @onchange="e => SetDeleteIso((bool)(e.Value ?? false))" />
            Move the ISO to the Recycle Bin once the disc is burned and verified
        </label>
        <label style="display: flex; gap: 8px; align-items: center; cursor: pointer; font-size: 13px;"
               title="Reads the whole fresh disc and saves a health report, like the bay's Disc health check. Adds about as long as a verify.">
            <input type="checkbox" checked="@healthCheck" @onchange="e => healthCheck = (bool)(e.Value ?? false)" />
            Disc health check after burning (shows any weak or slow areas)
        </label>
        <span class="bay-subtitle" style="margin: 0; color: var(--amber);">
            Burning can't be undone. Don't eject the disc or let the PC sleep while it burns.
        </span>
        <div style="display: flex; gap: 6px;">
            <button class="bay-btn game" style="flex: 2;" @onclick="StartBurn" disabled="@(CantStart || Disabled)">🔥 Start burn</button>
            <button class="bay-btn tray-btn" style="flex: 1;" @onclick="ChooseIso">Change ISO</button>
            <button class="bay-btn tray-btn" style="flex: 1;" @onclick="Reset">Cancel</button>
        </div>
    </div>
}
else if (state == State.Running)
{
    <div class="bay-status" style="flex-direction: column; align-items: stretch; gap: 6px; margin-top: 6px;">
        <div style="display: flex; justify-content: space-between; gap: 8px;">
            <strong>🔥 @(progress?.Phase ?? "Preparing")…</strong>
            @if (progress is not null && progress.Percent >= 0)
            {
                <span>@progress.Percent.ToString("0")%</span>
            }
        </div>
        <div class="progress-bar">
            <div class="progress-fill" style="width: @(progress is null || progress.Percent < 0 ? "100" : F(progress.Percent))%; @(progress is null || progress.Percent < 0 ? "opacity: 0.5;" : "")"></div>
        </div>
        <span class="bay-subtitle" style="margin: 0;">
            @Path.GetFileName(isoPath)
            @if (progress is not null && progress.BytesPerSec > 0)
            {
                <text> • @((progress.BytesPerSec / 1_000_000).ToString("0.0")) MB/s (@((progress.BytesPerSec / OneX).ToString("0.0"))x) • @Remaining left</text>
            }
            else if (progress?.Phase == "Finalizing")
            {
                <text> • closing the disc, this can take a minute or two</text>
            }
            else if (Switching)
            {
                <text> • @SwitchingNote</text>
            }
            else if (progress?.Phase == "Burning with ImgBurn")
            {
                <text> • @ImgBurnNote</text>
            }
        </span>
        <button class="bay-btn cancel-btn" @onclick="Cancel" disabled="@cancelRequested">
            @(cancelRequested ? "Stopping…" : progress?.Phase is "Verifying" or "Checking disc health" or "Waiting for the drive" ? "✖ Stop checking" : "✖ Cancel burn")
        </button>
    </div>
}
else if (state == State.Done && result is not null)
{
    <div class="bay-status" style="flex-direction: column; align-items: stretch; gap: 6px; margin-top: 6px;">
        <strong style="color: @ResultColor;">@ResultIcon @result.Message</strong>
        <span class="bay-subtitle" style="margin: 0;">
            @Path.GetFileName(isoPath)
            @if (result.Burned)
            {
                <text> • burned in @Dur(result.BurnTime)</text>
            }
            @if (result.Verified is not null)
            {
                <text> • checked in @Dur(result.VerifyTime)</text>
            }
            @if (health is not null && health.ReportPath is not null)
            {
                <text> • health report saved</text>
            }
        </span>
        <div style="display: flex; gap: 6px; flex-wrap: wrap;">
            @if (result.Burned)
            {
                <button class="bay-btn tray-btn" style="width: auto; flex: 1;" @onclick="Eject">⏏ Eject disc</button>
            }
            <button class="bay-btn tray-btn" style="width: auto; flex: 1;" @onclick="OpenIsoFolder">📂 ISO folder</button>
            <button class="bay-btn tray-btn" style="width: auto; flex: 1;" @onclick="Reset">Close</button>
        </div>
    </div>
}

@code {
    [Parameter] public string DriveLetter { get; set; } = "";
    [Parameter] public string BlankMediaType { get; set; } = "";
    [Parameter] public long BlankFreeBytes { get; set; }
    [Parameter] public long BlankTotalBytes { get; set; }
    [Parameter] public string DriveModel { get; set; } = "";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<bool> BusyChanged { get; set; }
    [Parameter] public EventCallback<bool> BurnFinished { get; set; }   // true = the disc was burned

    private enum State { Idle, Confirm, Running, Done }
    private State state = State.Idle;
    private string? isoPath;
    private long isoBytes;
    private bool verify = true;
    private BurnEngine.Progress? progress;
    private BurnEngine.Result? result;
    private CancellationTokenSource? cts;
    private bool cancelRequested;
    private bool useImgBurn;          // this burn's engine (Windows when false)
    private string? imgBurnPath;      // null = ImgBurn not found
    private bool engineLoaded;
    private bool deleteIso;           // move the ISO to the Recycle Bin after a verified burn
    private bool useDirect;           // v4.0: ArchivSector-OD's own writer (the default)
    private BurnService.Writer preferred = BurnService.Writer.Own;   // what the user picked last (saved)
    private string? engineNote;       // why the preferred program isn't the one picked for this disc
    private string DirectLabel => DirectAvailable ? "(recommended: whole disc, progress shown here)"
        : IsCue && BlankMediaType is "CD-R" or "CD-RW" ? "(can't burn this image, see above)"
        : IsCue ? "(BIN/CUE images go on CD-R or CD-RW)"
        : "(doesn't write " + BlankMediaType + " discs yet)";
    private string WholeDiscWriterName => DirectAvailable ? "ArchivSector-OD's own writer" : "ImgBurn";
    private string SwitchingNote => "ArchivSector-OD's own writer couldn't start, so another program is taking over";
    private string FallbackNote => "If the own writer can't start on this drive, " + BurnService.FallbackName() + " takes over automatically.";
    // Write speed (v4.0 week 6): the speeds the drive offers for this disc,
    // asked when an ISO is chosen. 0 = fastest. Not saved: it depends on the disc.
    private List<BurnEngine.WriteSpeed> speeds = new();
    private bool speedsLoading;
    private double speedX;
    private string OnlySpeedNote => "the only speed this drive offers for this disc";
    private string NoSpeedsNote => "the fastest the drive allows (it didn't list its speeds)";
    private string WindowsSpeedNote => "Windows' burning engine may ignore the speed and write at its own";
    private static string SpeedKey(double x) => x.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
    private string SpeedLog => speedX > 0 ? BurnEngine.SpeedText(speedX) : "fastest";

    private void OnSpeedChanged(ChangeEventArgs e)
    {
        speedX = double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var x) ? x : 0;
    }

    private async Task LoadSpeeds()
    {
        speedsLoading = true;
        speeds = new();
        speedX = 0;
        var letter = DriveLetter;
        List<BurnEngine.WriteSpeed> found;
        try { found = await Task.Run(() => BurnEngine.QueryWriteSpeeds(letter)); }
        catch { found = new(); }
        speeds = found;
        speedsLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private bool Switching => progress is not null && progress.Phase.StartsWith("Switching to");
    private bool DirectAvailable => IsCue
        ? BlankMediaType is "CD-R" or "CD-RW" && cue?.Problem is null
        : BurnEngine.DirectWriteSupports(BlankMediaType);

    // BIN/CUE CD images (beta 2): our own writer (CD-R/RW) or ImgBurn; Windows can't.
    private CueImage? cue;
    private bool IsCue => isoPath is not null && isoPath.EndsWith(".cue", StringComparison.OrdinalIgnoreCase);
    private string CueLine => cue is null ? "" : cue.Problem is null ? "BIN/CUE CD image: " + cue.Summary : "";
    private string? CueProblem => !IsCue ? null
        : BlankMediaType is not ("CD-R" or "CD-RW") ? "A BIN/CUE image is a CD image: it needs a blank CD-R or CD-RW, not a " + BlankMediaType + "."
        : cue?.Problem is not null ? cue.Problem + (imgBurnPath is not null ? " ImgBurn is picked for it." : "")
        : null;
    private string BurnButtonText => BlankMediaType is "CD-R" or "CD-RW" ? "🔥 Burn an ISO or BIN/CUE to this disc…" : "🔥 Burn an ISO to this disc…";
    private string WindowsLabel => IsCue ? "(can't burn BIN/CUE images)" : "(built in, progress shown here)";
    private string EngineName => useDirect ? "ArchivSector-OD's own writer" : useImgBurn ? "ImgBurn" : "Windows";
    private bool runningDirect;       // the burn running now uses our own writer on a disc where stopping is harmless (BD-RE, DVD+RW)
    private static bool healthCheck;  // health check after burning (remembered for this session)
    private DiscHealthService.Result? health;

    // The last folder an ISO was picked from (this session).
    private static string? lastIsoFolder;

    private double OneX => BlankMediaType.StartsWith("BD") ? 4_500_000 : BlankMediaType.StartsWith("DVD") ? 1_385_000 : 153_600;
    // The disc's full size, and how much the chosen program can write.
    // On BD-R, Windows' burning engine can report less free space than the
    // disc really has; ImgBurn writes the whole disc.
    private long DiscBytes => BurnEngine.FullDiscBytes(BlankMediaType, Math.Max(BlankTotalBytes, BlankFreeBytes));

    // Windows formats a blank BD-R/BD-RE with spare areas (768 MB on a
    // single-layer disc) and only reports what's left; ImgBurn burns the
    // whole disc. BurnEngine.FullDiscBytes works out the real size.
    private long Limit => useImgBurn || useDirect ? DiscBytes : BlankFreeBytes;
    private bool TooBigForWindows => isoBytes > BlankFreeBytes;
    private bool TooBigForDisc => isoBytes > DiscBytes;
    private bool CantStart => IsCue
        ? (BlankMediaType is not ("CD-R" or "CD-RW")) || (!useDirect && !useImgBurn) || (useDirect && TooBigForDisc)
        : useImgBurn || useDirect ? TooBigForDisc : TooBigForWindows;

    private string ImgBurnNote => verify
        ? "follow the progress in the ImgBurn window; ImgBurn verifies the disc after writing it"
        : "follow the progress in the ImgBurn window";
    private string Remaining => progress is null ? "" : Dur(progress.Remaining);
    private static string Dur(TimeSpan t) => t.TotalHours >= 1 ? $"{(int)t.TotalHours}h {t.Minutes}m" : t.TotalMinutes >= 1 ? $"{(int)t.TotalMinutes} min" : $"{t.Seconds}s";
    private static string F(double v) => v.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    private bool HealthBad => health?.Verdict == DiscHealthService.Level.Damaged;
    private string ResultColor => HealthBad ? "var(--danger)" : result?.Verified == true ? "var(--success)"
        : result?.Verified == false || result?.Burned != true ? "var(--danger)" : "var(--amber)";
    private string ResultIcon => HealthBad ? "⚠" : result?.Verified == true ? "✅" : result?.Verified == false || result?.Burned != true ? "⚠" : "✓";

    protected override void OnParametersSet()
    {
        // The blank disc was taken out before burning: go back to idle.
        if (state == State.Confirm && string.IsNullOrEmpty(BlankMediaType)) Reset();
    }

    private void ChooseIso()
    {
        var dlg = new Microsoft.Win32.OpenFileDialog
        {
            Title = BlankMediaType is "CD-R" or "CD-RW" ? $"Choose the ISO or BIN/CUE image to burn to the {BlankMediaType}" : $"Choose the ISO to burn to the {BlankMediaType}",
            Filter = "Disc images (*.iso, *.cue)|*.iso;*.cue|ISO images (*.iso)|*.iso|BIN/CUE CD images (*.cue)|*.cue|All files (*.*)|*.*",
        };
        if (lastIsoFolder is not null && Directory.Exists(lastIsoFolder)) dlg.InitialDirectory = lastIsoFolder;
        if (dlg.ShowDialog(System.Windows.Application.Current.MainWindow) != true) return;
        isoPath = dlg.FileName;
        lastIsoFolder = Path.GetDirectoryName(isoPath);
        try { isoBytes = new FileInfo(isoPath).Length; } catch { isoBytes = 0; }
        // A BIN/CUE CD image (beta 2): its size is the sectors it fills.
        cue = IsCue ? CueImage.Load(isoPath) : null;
        if (cue is not null && cue.Problem is null) isoBytes = (cue.LeadOutLba + 150) * 2048L;
        if (!engineLoaded)
        {
            imgBurnPath = BurnService.ImgBurnPath();
            preferred = BurnService.SavedWriter();
            deleteIso = ConfigService.Load().DeleteIsoAfterBurn;
            engineLoaded = true;
        }
        ApplyPreferred();
        state = State.Confirm;
        _ = LoadSpeeds();
        LogService.Write($"{DriveLetter}:", $"Burn: chose {isoPath} ({isoBytes:N0} bytes). Blank {BlankMediaType}: disc {DiscBytes:N0} bytes, Windows engine free {BlankFreeBytes:N0} bytes");
    }

    // The program the user prefers, if it can burn this disc; otherwise the
    // next best (own writer → ImgBurn → Windows), with a note saying why.
    private void ApplyPreferred()
    {
        engineNote = null;
        useDirect = false;
        useImgBurn = false;
        var want = preferred;
        if (want == BurnService.Writer.ImgBurn && imgBurnPath is null) want = BurnService.Writer.Own;
        if (IsCue && want == BurnService.Writer.Windows) want = DirectAvailable ? BurnService.Writer.Own : BurnService.Writer.ImgBurn;
        if (want == BurnService.Writer.Own && !DirectAvailable)
        {
            want = imgBurnPath is not null ? BurnService.Writer.ImgBurn : BurnService.Writer.Windows;
            var instead = imgBurnPath is not null ? "ImgBurn" : "Windows";
            if (!IsCue) engineNote = "ArchivSector-OD's own writer doesn't write " + BlankMediaType + " discs yet, so " + instead + " is picked.";
        }
        if (IsCue && want == BurnService.Writer.Windows) { useDirect = false; useImgBurn = false; return; }   // nothing can burn it here
        useDirect = want == BurnService.Writer.Own;
        useImgBurn = want == BurnService.Writer.ImgBurn;
        // An ISO that only fits on the whole disc (Windows keeps part of a
        // BD-R spare) gets a program that uses the whole disc. Not saved as
        // a preference.
        if (!useDirect && !useImgBurn && TooBigForWindows && !TooBigForDisc && (DirectAvailable || imgBurnPath is not null))
        {
            useDirect = DirectAvailable;
            useImgBurn = !DirectAvailable;
            engineNote = "Windows can't fit this ISO on the disc (it keeps part of it spare), so " + WholeDiscWriterName + " is picked.";
        }
    }

    // A program picked on this screen is remembered for next time.
    private void Pick(BurnService.Writer w)
    {
        if (IsCue && w == BurnService.Writer.Windows) return;
        engineNote = null;
        useDirect = w == BurnService.Writer.Own && DirectAvailable;
        useImgBurn = w == BurnService.Writer.ImgBurn && imgBurnPath is not null;
        preferred = w;
        BurnService.SaveWriter(w);
    }

    private void SetDeleteIso(bool on)
    {
        deleteIso = on;
        try
        {
            var config = ConfigService.Load();
            config.DeleteIsoAfterBurn = on;
            ConfigService.Save(config);
        }
        catch { }
    }

    private async Task StartBurn()
    {
        if (isoPath is null) return;
        state = State.Running;
        progress = null;
        result = null;
        cancelRequested = false;
        cts = new CancellationTokenSource();
        await BusyChanged.InvokeAsync(true);
        StateHasChanged();

        var path = isoPath;
        var title = Path.GetFileNameWithoutExtension(path);
        bool direct = useDirect && DirectAvailable;
        runningDirect = direct && BurnEngine.DirectStopIsSafe(BlankMediaType);
        bool imgBurn = useImgBurn && !direct;
        bool delete = deleteIso && verify && !IsCue;
        string engineName = direct ? "ArchivSector-OD's own writer" : imgBurn ? "ImgBurn" : "Windows";
        double speed = speedX;
        LogService.Write($"{DriveLetter}:", $"Burn started: {path} -> {BlankMediaType} with {engineName} (speed: {SpeedLog}, verify: {(verify ? "yes" : "no")}, delete ISO after: {(delete ? "yes" : "no")})");
        var reporter = new Progress<BurnEngine.Progress>(p => InvokeAsync(() =>
        {
            progress = p;
            // Our own writer handed over to another program: stopping that one isn't harmless.
            if (p.Phase.StartsWith("Switching to")) runningDirect = false;
            StateHasChanged();
        }));
        BurnEngine.Result r;
        try
        {
            r = await BurnService.BurnAsync(DriveLetter, path, verify, title, DriveModel, reporter, cts.Token, imgBurn, delete, direct, speed);
        }
        catch (Exception ex)
        {
            r = new BurnEngine.Result { Message = $"The burn failed: {ex.Message}" };
        }
        LogService.Write($"{DriveLetter}:", "Burn finished: " + r.Message);

        // Optional health check on the fresh disc (not after a failed verify:
        // that disc is already known to be bad).
        health = null;
        if (healthCheck && r.Burned && r.Verified != false && !cts.IsCancellationRequested)
        {
            health = await BurnService.HealthCheckAfterBurnAsync(DriveLetter, title, DriveModel, reporter, cts.Token);
            if (health is not null) r.Message += " " + BurnService.HealthLine(health);
        }

        result = r;
        state = State.Done;
        cts.Dispose();
        cts = null;
        await BusyChanged.InvokeAsync(false);
        await BurnFinished.InvokeAsync(r.Burned);
        try { if (ConfigService.Load().SoundAlerts) System.Media.SystemSounds.Exclamation.Play(); } catch { }
        StateHasChanged();
    }

    private void Cancel()
    {
        if (cts is null) return;
        // Stopping our own writer on a BD-RE or DVD+RW doesn't ruin the disc, so no warning is needed.
        if (!runningDirect && progress?.Phase is not ("Verifying" or "Checking disc health" or "Waiting for the drive"))
        {
            var owner = System.Windows.Application.Current?.MainWindow;
            var msg = progress?.Phase == "Burning with ImgBurn"
                ? "Stop burning?\n\nImgBurn will ask you to confirm in its own window. A write-once disc that's stopped part-way can't be used again."
                : "Stop burning?\n\nA write-once disc that's stopped part-way can't be used again.";
            var ans = owner is null
                ? MessageBox.Show(msg, "Cancel burn", MessageBoxButton.YesNo, MessageBoxImage.Warning)
                : MessageBox.Show(owner, msg, "Cancel burn", MessageBoxButton.YesNo, MessageBoxImage.Warning);
            if (ans != MessageBoxResult.Yes) return;
        }
        cancelRequested = true;
        cts.Cancel();
    }

    private void Eject()
    {
        var letter = DriveLetter;
        _ = Task.Run(() => TrayControlService.EjectWithoutVolume(letter));
        Reset();
    }

    private void OpenIsoFolder()
    {
        var dir = isoPath is null ? null : Path.GetDirectoryName(isoPath);
        if (dir is null) return;
        try { System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo { FileName = dir, UseShellExecute = true }); } catch { }
    }

    private void Reset()
    {
        state = State.Idle;
        isoPath = null;
        result = null;
        health = null;
        progress = null;
    }

    // Never cancel a burn just because the screen was redrawn; the burn
    // carries on in the background and the updater won't interrupt it.
    public void Dispose() { }
}
