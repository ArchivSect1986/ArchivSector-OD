<Window x:Class="ArchivSector_OD.TrackPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Audio &amp; Subtitle Tracks"
        Height="580" Width="560"
        Background="#141b2d"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Output Name" Foreground="#e5e9f5" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
            <TextBox x:Name="OutputNameBox" Background="#1b2438" Foreground="#e5e9f5" BorderBrush="#2a3550" Padding="6"/>
            <TextBlock Text="The file will be created by MakeMKV as usual, then renamed to this once it's done."
                       Foreground="#8b93a8" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="#8b93a8" FontSize="11" Margin="0,0,0,10"
                   Text="Choose which audio and subtitle tracks to keep. MakeMKV always extracts everything first, then mkvmerge trims the result down to exactly this selection afterward."/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Audio Tracks" Foreground="#e5e9f5" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                <ItemsControl x:Name="AudioList" Margin="0,0,0,14">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding DisplayText}" IsChecked="{Binding IsChecked}" Foreground="#e5e9f5" Margin="4,4"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="NoAudioText" Text="No audio tracks found." Foreground="#5b6478" FontStyle="Italic" FontSize="11" Margin="4,0,0,14" Visibility="Collapsed"/>

                <TextBlock Text="Subtitle Tracks" Foreground="#e5e9f5" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                <ItemsControl x:Name="SubList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding DisplayText}" IsChecked="{Binding IsChecked}" Foreground="#e5e9f5" Margin="4,4"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="NoSubText" Text="No subtitle tracks found." Foreground="#5b6478" FontStyle="Italic" FontSize="11" Margin="4,0,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="90" Height="32" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button Content="Extract With These Tracks" Background="#10b981" Foreground="Black" FontWeight="Bold" Width="190" Height="32" Click="ExtractButton_Click"/>
        </StackPanel>
    </Grid>
</Window>