    private void ViewCatalog()
    {
        var path = TargetFillService.CatalogToOpen(HasFolder ? folder : null);
        if (path is null)
        {
            Ask("No disc catalog yet.\n\nWith 'Searchable Disc Library Indexer' turned on, every disc you master is added to:\n" + TargetFillService.MasterCatalogPath,
                "Disc Catalog", MessageBoxButton.OK, MessageBoxImage.Information);
            return;
        }
        try { System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo { FileName = path, UseShellExecute = true }); }
        catch (Exception ex) { ShowResult(false, $"Couldn't open the catalog: {ex.Message}"); }
    }

    private void ToggleRightClick()
    {
        var msg = TargetFillService.SetRightClick(!rightClickInstalled);
        rightClickInstalled = TargetFillService.IsRightClickInstalled();
        ShowResult(!msg.StartsWith("Couldn't"), msg);
    }

    // Runs a service call off the UI thread with the busy bar showing.
    // While it runs, the updater won't start (RipActivity).
    private async Task<TargetFillService.Result?> RunJob(Func<TargetFillService.Result> job, string? startText = null)
    {
        busy = true;
        progressText = startText ?? "Starting…";
        resultMessage = null;
        RipActivity.Set("TargetFill", "job", true);
        StateHasChanged();
        try
        {
            return await Task.Run(job);
        }
        catch (Exception ex)
        {
            return new TargetFillService.Result { Message = $"Something went wrong: {ex.Message}" };
        }
        finally
        {
            RipActivity.Set("TargetFill", "job", false);
            busy = false;
            StateHasChanged();
        }
    }

    // ---- batch ----

    private sealed class BatchItem
    {
        public string Folder = "";
        public bool Working;
        public bool? Ok;            // result of the last run: null = not run yet
        public string? Detail;
        public bool IsoDone;        // ISOs built (a later run of the same kind skips it)
        public bool PadDone;        // filler added
    }

    private readonly List<BatchItem> batch = new();
    private bool batchRunning;
    private bool batchStop;

    private static string BatchIcon(BatchItem b) => b.Working ? "⏳" : b.Ok == true ? "✅" : b.Ok == false ? "⚠️" : "•";

    // Folders the next "Build all ISOs" / "Pad all folders" will do: every
    // folder not already done with that same action.
    private int BatchTodo(bool iso) => batch.Count(b => iso ? !b.IsoDone : !b.PadDone);

    private void AddToBatch(string path)
    {
        string full;
        try { full = TargetFillService.NormalizePath(path); } catch { return; }
        if (!Directory.Exists(full)) return;
        if (batch.Any(b => string.Equals(b.Folder, full, StringComparison.OrdinalIgnoreCase))) return;
        batch.Add(new BatchItem { Folder = full });
    }

    private void AddBatchFolders()
    {
        var dlg = new Microsoft.Win32.OpenFolderDialog { Title = "Choose folders for the batch (hold Ctrl to pick several)", Multiselect = true };
        if (HasFolder) dlg.InitialDirectory = Path.GetDirectoryName(folder) ?? folder;
        if (dlg.ShowDialog(System.Windows.Application.Current.MainWindow) == true)
            foreach (var f in dlg.FolderNames) AddToBatch(f);
    }

    private void AddCurrentToBatch()
    {
        if (HasFolder) AddToBatch(folder);
    }

    private void ClearBatch() => batch.Clear();

    private void ResetBatch()
    {
        foreach (var b in batch) { b.IsoDone = b.PadDone = false; b.Ok = null; b.Detail = null; }
    }

    // Runs every folder that isn't done yet, one at a time. A folder that
    // fails is marked and the batch carries on with the next one.
    private async Task RunBatch(bool iso)
    {
        var todo = batch.Where(b => iso ? !b.IsoDone : !b.PadDone).ToList();
        if (todo.Count == 0) return;
        if (iso && todo.Count > 1)
        {
            var multi = todo.Count;
            if (Ask($"Build ISO images for {multi} folders with these settings ({Medium.Label})?\n\n" +
                    "Each folder gets its own name as the volume label. A folder too big for one disc is split into several ISOs automatically.",
                    "Batch ISO Build", MessageBoxButton.YesNo, MessageBoxImage.Question) != MessageBoxResult.Yes)
                return;
        }

        batchRunning = true;
        batchStop = false;
        busy = true;
        resultMessage = null;
        RipActivity.Set("TargetFill", "job", true);
        int done = 0, failed = 0, processed = 0;
        try
        {
            for (int i = 0; i < todo.Count; i++)
            {
                if (batchStop) break;
                var item = todo[i];
                var name = Path.GetFileName(item.Folder.TrimEnd('\\', '/'));
                item.Working = true;
                item.Ok = null;
                item.Detail = iso ? "Building ISO…" : "Adding filler…";
                var prefix = $"Folder {i + 1} of {todo.Count} ({name}): ";
                progressText = prefix + "starting…";
                StateHasChanged();

                var o = CurrentOptions();
                o.VolumeLabel = "";   // each folder is named after itself
                var f = item.Folder;
                void Log(string text) => InvokeAsync(() => { progressText = prefix + text; item.Detail = text; StateHasChanged(); });

                TargetFillService.Result r;
                try
                {
                    r = await Task.Run(() => iso ? TargetFillService.BuildIso(f, o, Log) : TargetFillService.GenerateFiller(f, o, Log));
                }
                catch (Exception ex)
                {
                    r = new TargetFillService.Result { Message = $"Something went wrong: {ex.Message}" };
                }

                item.Working = false;
                item.Ok = r.Ok;
                if (r.Ok)
                {
                    // Building an ISO first removes the folder's own filler (it
                    // goes inside the ISO instead), so it's no longer padded.
                    if (iso) { item.IsoDone = true; item.PadDone = false; }
                    else item.PadDone = true;
                }
                item.Detail = r.Ok
                    ? (r.Outputs.Count > 0 && iso ? string.Join(", ", r.Outputs) : r.Message)
                    : r.Message + (r.TooBig ? " (Build all ISOs splits it across several discs.)" : "");
                LogService.Write("TargetFill", "Batch " + (iso ? "ISO" : "pad") + " [" + f + "]: " + (r.Ok ? "OK " : "PROBLEM ") + item.Detail);
                if (r.Ok)
                {
                    done++;
                    if (o.Catalog)
                    {
                        try { TargetFillService.RecordHistory(name, o.Media.Label, f); } catch { /* history is best-effort */ }
                    }
                }
                else failed++;
                processed++;
                StateHasChanged();
            }
        }
        finally
        {
            RipActivity.Set("TargetFill", "job", false);
            busy = false;
            batchRunning = false;
        }

        int left = todo.Count - processed;
        var msg = $"Batch finished: {done} folder(s) done" + (failed > 0 ? $", {failed} failed (see the list)" : "") +
                  (batchStop && left > 0 ? $", {left} not started (stopped)" : "") + ".";
        ShowResult(failed == 0, msg);
        batchStop = false;
        if (HasFolder) await Rescan();
        await ApplyPendingRequest();
    }

    // A folder sent from a drive bay while a job was running.
    private async Task ApplyPendingRequest()
    {
        if (busy || pendingRequest is null) return;
        var p = pendingRequest;
        pendingRequest = null;
        volumeLabel = "";
        Persist();
        await SetFolder(p);
    }

    private async Task Finish(TargetFillService.Result r, TargetFillService.Options o, string f)
    {
        ShowResult(r.Ok, r.Message, r.Outputs, r.Notes);
        if (r.Ok && o.Catalog)
        {
            var title = string.IsNullOrWhiteSpace(o.VolumeLabel) ? new DirectoryInfo(f).Name : o.VolumeLabel.Trim();
            try { TargetFillService.RecordHistory(title, o.Media.Label, f); } catch { /* history is best-effort */ }
        }
        await Rescan();
        await ApplyPendingRequest();
    }

    private void Progress(string text)
    {
        InvokeAsync(() => { progressText = text; StateHasChanged(); });
    }

    public void Dispose()
    {
        if (busy) RipActivity.Set("TargetFill", "job", false);
    }
}
