@using ArchivSector_OD.Burning
@implements IDisposable

@*
    Burn tab: every recorder, what it can write, and what disc is in it,
    plus the burn queue (several ISOs one after another, v4.0 week 2).
    A drive with a blank disc gets the same burn screen as the drive bays
    (BurnPanel), backed by the shared engine in ArchivSector-OD.Burning.

    AppShell keeps every tab loaded and only hides the inactive ones, so
    this waits until it's first shown (Visible) before scanning -- it never
    spins up the drives just because the app started. Drives that are busy
    ripping, burning or being checked are skipped, so their work isn't
    disturbed. Uses the app's own styles, so it follows the theme.
*@

<div class="bays-grid" style="grid-template-columns: 1fr;">
    <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;">
        <div>
            <h2 style="margin: 0;">🔥 Burn</h2>
            <p class="bay-subtitle" style="margin: 2px 0 0; color: var(--text-muted); font-size: 12px;">
                Your disc recorders and the disc in each one.
            </p>
        </div>
        <button class="shortcut-btn" @onclick="ScanAsync" disabled="@scanning">
            @(scanning ? "⏳ Scanning drives…" : "🔄 Refresh drives")
        </button>
    </div>

    @* Modes (v4.0 week 3): Write = the burn queue and the drives; Build =
       make an ISO from a folder; Read = copy a data disc to an ISO. All
       stay loaded, so a build, read or queue keeps going while another
       mode is showing. *@
    <nav class="app-nav" aria-label="Burn modes" style="justify-self: start;">
        <button class="nav-btn @(mode == "write" ? "active" : "")" @onclick='() => mode = "write"'>🔥 Write</button>
        <button class="nav-btn @(mode == "build" ? "active" : "")" @onclick='() => mode = "build"'>📦 Build ISO</button>
        <button class="nav-btn @(mode == "read" ? "active" : "")" @onclick='() => mode = "read"'>📀 Read disc</button>
    </nav>

    <div style="display: @(mode == "build" ? "block" : "none");">
        <BuildPanel AddToQueue="@OnAddToQueue" />
    </div>

    <div style="display: @(mode == "read" ? "block" : "none");">
        <ReadPanel AddToQueue="@OnAddToQueue" Visible="@(Visible && mode == "read")" />
    </div>

    <div style="display: @(mode == "write" ? "flex" : "none"); flex-direction: column; gap: 16px;">

    @* The burn queue (v4.0 week 2). It's kept on screen through rescans and
       scan errors, so a running queue is never thrown away. *@
    @if (queueDrives.Count > 0)
    {
        <BurnQueuePanel @ref="queue" Drives="@queueDrives" Finished="@OnQueueFinished" />
    }

    @if (error is not null)
    {
        <p style="color: var(--danger); margin: 0;">⚠ @error</p>
    }
    else if (drives is null)
    {
        <p style="color: var(--text-muted); margin: 0;">Scanning drives… (a drive may need a moment to spin up)</p>
    }
    else if (drives.Count == 0)
    {
        <p style="color: var(--text-muted); margin: 0;">No disc recorders were found on this PC.</p>
    }
    else
    {
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px;">
            @foreach (var drive in drives)
            {
                <div class="bay-card">
                    <h2>@drive.DisplayName</h2>

                    @if (drive.Error is not null)
                    {
                        <p style="color: var(--danger); font-size: 13px; margin: 8px 0 0;">⚠ Couldn't read this drive: @drive.Error</p>
                    }
                    else
                    {
                        <p class="bay-subtitle">
                            Firmware @(drive.Firmware.Length > 0 ? drive.Firmware : "—") • Writes @drive.WriteFormatsText
                        </p>

                        @if (drive.Busy)
                        {
                            <p class="bay-meta" style="color: var(--amber);">⏳ In use (ripping, burning or checking) — the disc wasn't read, so that work isn't disturbed.</p>
                        }
                        else if (drive.Media.State == MediaState.NoDisc)
                        {
                            <p class="bay-meta">No disc in drive</p>
                        }
                        else
                        {
                            <div style="display: flex; flex-direction: column; gap: 3px; font-size: 13px;">
                                <div style="display: flex; justify-content: space-between; gap: 10px;">
                                    <span style="color: var(--text-muted);">Disc</span>
                                    <span>@drive.Media.TypeName@(drive.Media.IsRewritable ? " (rewritable)" : "")</span>
                                </div>
                                <div style="display: flex; justify-content: space-between; gap: 10px;">
                                    <span style="color: var(--text-muted);">Status</span>
                                    <span style="color: @(drive.Media.CanBurnNow ? "var(--success)" : "var(--text-muted)"); font-weight: @(drive.Media.CanBurnNow ? "600" : "400");">@drive.Media.StateText</span>
                                </div>
                                @if (drive.Media.TotalSectors > 0)
                                {
                                    <div style="display: flex; justify-content: space-between; gap: 10px;">
                                        <span style="color: var(--text-muted);">Capacity</span>
                                        <span>@DiscHealthService.FormatBytes(drive.Media.FullDiscBytes)</span>
                                    </div>
                                    <div style="display: flex; justify-content: space-between; gap: 10px;">
                                        <span style="color: var(--text-muted);">Free</span>
                                        <span>@DiscHealthService.FormatBytes(drive.Media.State == MediaState.Blank ? drive.Media.FullDiscBytes : drive.Media.FreeBytes)</span>
                                    </div>
                                    @if (drive.Media.WindowsSpareBytes > 0)
                                    {
                                        <span class="bay-subtitle" style="margin: 4px 0 0;">
                                            Windows' burning engine keeps @(DiscHealthService.FormatBytes(drive.Media.WindowsSpareBytes)) of this disc spare and can write
                                            @(DiscHealthService.FormatBytes(drive.Media.TotalBytes)); ImgBurn uses the whole disc.
                                        </span>
                                    }
                                }
                            </div>
                        }

                        @* Burning: a blank disc (or a burn that's running or just
                           finished on this drive) shows the burn screen. *@
                        @if (CanShowBurn(drive))
                        {
                            <BurnPanel DriveLetter="@Letter(drive)"
                                       BlankMediaType="@(drive.Media.State == MediaState.Blank ? drive.Media.TypeName : "")"
                                       BlankFreeBytes="@drive.Media.FreeBytes"
                                       BlankTotalBytes="@drive.Media.TotalBytes"
                                       DriveModel="@ModelName(drive)"
                                       Disabled="@false"
                                       BusyChanged="@(b => OnBurnBusy(drive, b))"
                                       BurnFinished="@(_ => OnBurnFinished(drive))" />
                        }
                    }
                </div>
            }
        </div>
    }
    </div>
</div>

@code {
    /// <summary>True while the Burn tab is the one showing.</summary>
    [Parameter] public bool Visible { get; set; }

    private IReadOnlyList<BurnerDrive>? drives;
    private string mode = "write";
    private BurnQueuePanel? queue;

    // Build mode finished an ISO and wants it in the queue.
    private void OnAddToQueue(string isoPath) => queue?.AddIso(isoPath);
    // Recorders the queue can use: writers, plus busy drives (a busy drive
    // isn't asked what it writes, and may be the one the queue is using).
    private IReadOnlyList<BurnerDrive> queueDrives = Array.Empty<BurnerDrive>();
    private void UpdateQueueDrives()
    {
        if (drives is null) return;
        var list = drives.Where(d => d.DriveLetter.Length > 0 && d.Error is null && (d.CanWrite || d.Busy)).ToList();
        if (list.Count > 0 || queueDrives.Count == 0) queueDrives = list;
    }
    private bool scanning;
    private bool scannedOnce;
    private string? error;
    private bool disposed;

    // Drives whose burn screen is in use here (burning, or showing a result),
    // kept on screen even though the scan now reports them busy or not blank.
    private readonly HashSet<string> burnScreens = new(StringComparer.OrdinalIgnoreCase);

    private static string Letter(BurnerDrive d) => d.DriveLetter.TrimEnd(':');
    private static string ModelName(BurnerDrive d) => (d.Vendor + " " + d.Model).Trim();

    // A burn screen that's in use here always stays (even while the scan
    // reports the drive busy); otherwise only a writer with a blank disc.
    private bool CanShowBurn(BurnerDrive d) =>
        d.DriveLetter.Length > 0 &&
        (burnScreens.Contains(Letter(d)) || (!d.Busy && d.CanWrite && d.Media.State == MediaState.Blank));

    private void OnBurnBusy(BurnerDrive d, bool busy)
    {
        if (busy) burnScreens.Add(Letter(d));
    }

    // After a burn the disc isn't blank any more: re-read just that drive
    // (the burn screen stays up to show the result until it's closed).
    private async Task OnBurnFinished(BurnerDrive d)
    {
        try
        {
            var fresh = await BurnerScanner.ScanDriveAsync(d.UniqueId, letter => RipActivity.IsDriveBusy(letter) || BurnService.IsBusy(letter));
            if (drives is not null)
            {
                drives = drives.Select(x => x.UniqueId == d.UniqueId ? fresh : x).ToList();
                UpdateQueueDrives();
            }
        }
        catch { }
        if (!disposed) StateHasChanged();
    }

    // A burn queue ended: re-read that drive, so it no longer shows "in use".
    private async Task OnQueueFinished(string letter)
    {
        var d = drives?.FirstOrDefault(x => Letter(x).Equals(letter, StringComparison.OrdinalIgnoreCase));
        if (d is not null) await OnBurnFinished(d);
    }

    // First time the tab is shown: scan. After that, only "Refresh drives".
    protected override async Task OnParametersSetAsync()
    {
        if (Visible && !scannedOnce)
        {
            scannedOnce = true;
            await ScanAsync();
        }
    }

    private async Task ScanAsync()
    {
        if (scanning) return;
        scanning = true;
        error = null;
        StateHasChanged();
        try
        {
            // The drive bays and burns report busy drives here.
            drives = await BurnerScanner.ScanAsync(letter => RipActivity.IsDriveBusy(letter) || BurnService.IsBusy(letter));
            UpdateQueueDrives();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            scanning = false;
        }
        if (!disposed) StateHasChanged();
    }

    public void Dispose() => disposed = true;
}
