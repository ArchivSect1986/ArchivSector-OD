<Window x:Class="ArchivSector_OD.IsoVerifierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ArchivSector-OD - ISO Verifier"
        Height="580" Width="720" MinHeight="360" MinWidth="520"
        FontSize="12.5"
        WindowStartupLocation="CenterOwner">
    <!-- Colours, corners and font come from the theme (WpfTheme.Apply in the
         code), so every colour here is a {DynamicResource …} name. -->
    <Grid Margin="18,16,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🔍 ISO Verifier" Foreground="{DynamicResource Text}" FontWeight="SemiBold" FontSize="20"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="{DynamicResource TextSec}" Margin="0,4,0,12"
                   Text="Checks an ISO, or every ISO in a folder (ones made by other programs too), against the Redump lists imported in Settings → Redump checks."/>

        <Border Grid.Row="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Edge}" BorderThickness="1"
                CornerRadius="{DynamicResource Radius}" Padding="12,8" Margin="0,0,0,12">
            <TextBlock x:Name="PathText" Text="No file or folder chosen yet." Foreground="{DynamicResource Text}" FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="SelectFileButton" Content="💿 Choose an ISO…" Click="SelectFileButton_Click"/>
            <Button x:Name="SelectFolderButton" Content="📂 Choose a folder…" Margin="8,0,0,0" Click="SelectFolderButton_Click"/>
            <Button x:Name="VerifyButton" Content="✅ Verify" Style="{DynamicResource AccentButton}" FontWeight="SemiBold" Margin="8,0,0,0" IsEnabled="False" Click="VerifyButton_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="4" x:Name="StatusText" Foreground="{DynamicResource Muted}" FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="5" x:Name="ResultText" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <TextBox Grid.Row="6" x:Name="ResultsBox" FontFamily="Consolas" FontSize="11.5" VerticalContentAlignment="Stretch"
                 IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 Visibility="Collapsed" Margin="0,0,0,12"/>

        <Button Grid.Row="7" Content="Close" MinWidth="90" HorizontalAlignment="Right" Click="CloseButton_Click"/>
    </Grid>
</Window>
