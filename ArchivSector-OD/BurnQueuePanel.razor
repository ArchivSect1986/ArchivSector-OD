@using System.IO
@using System.Windows
@using ArchivSector_OD.Burning
@implements IDisposable

@*
    Burn queue (v4.0 week 2): several ISOs burned one after another on one
    drive. For each ISO it waits for a blank disc, burns it (ArchivSector-
    OD's own writer by default, or ImgBurn or Windows: the same choice as
    everywhere else, remembered; a disc the own writer doesn't handle gets
    ImgBurn, or Windows without it), verifies it, can run a
    disc health check on the fresh disc, then ejects it and asks for the
    next blank. The drive is marked busy for the whole queue, so the drive
    bays and the Burn tab's scan leave it alone.
    Beta 4: ISOs and .cue files (or folders of them) can be dropped onto
    the queue from Explorer (FileDrop). The list of images still to burn is
    kept in %AppData%\ArchivSector-OD\burn-queue.txt and put back when the
    app starts again.
*@

<div class="bay-card" data-file-drop="@(running ? null : "burn-queue")">
    <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px;">
        <h2 style="margin: 0;">📚 Burn queue</h2>
        <div style="display: flex; flex-wrap: wrap; gap: 6px;">
            <button class="shortcut-btn" @onclick="AddIsos" disabled="@running">➕ Add ISOs…</button>
            @if (items.Count > 0 && !running)
            {
                <button class="shortcut-btn" @onclick="ClearList">Clear</button>
            }
        </div>
    </div>
    <p class="bay-subtitle" style="color: var(--text-secondary); font-size: 12px;">Burn several ISOs (or BIN/CUE CD images) one after another. After each disc it's ejected, and the next one starts when you put in a blank. You can also drag them here from File Explorer.</p>
    @if (restoredNote is not null)
    {
        <p style="margin: 0 0 8px; font-size: 12px; color: var(--text-secondary);">↺ @restoredNote</p>
    }
    @if (dropNote is not null)
    {
        <p style="margin: 0 0 8px; font-size: 12px; color: var(--amber);">⚠ @dropNote</p>
    }

    @if (items.Count == 0)
    {
        <p style="margin: 0; font-size: 13px; color: var(--text-secondary);">Add ISOs, or drop them here, to start a queue.</p>
    }
    else
    {
        <div style="display: flex; flex-direction: column; gap: 6px;">
            @foreach (var it in items)
            {
                <div style="display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--text-primary);">
                    <span style="width: 18px; text-align: center;">@Icon(it)</span>
                    <span style="flex: 1; min-width: 0; overflow-wrap: anywhere;" title="@it.Path">
                        <strong>@Path.GetFileName(it.Path)</strong>
                        <span style="display: block; font-size: 12px; color: var(--text-secondary);">@Line(it)</span>
                    </span>
                    @if (!running)
                    {
                        <button class="shortcut-btn" @onclick="() => MoveUp(it)" disabled="@(items.IndexOf(it) == 0)" title="Burn this one earlier">▲</button>
                        <button class="shortcut-btn" @onclick="() => { items.Remove(it); }" title="Take it off the list (the file isn't touched)">✖</button>
                    }
                </div>
            }
        </div>

        @if (!running)
        {
            <div style="display: flex; flex-direction: column; gap: 10px; font-size: 13px; margin-top: 12px; color: var(--text-primary);">
                <div style="display: flex; gap: 10px; align-items: center;">
                    <strong style="min-width: 80px;">Drive</strong>
                    <select class="settings-input" @bind="driveLetter" @bind:after="CheckSpeeds" style="flex: 1; font-size: 13px;">
                        @foreach (var d in Drives)
                        {
                            <option value="@Letter(d)" style="background: var(--bg-panel-alt); color: var(--text-primary);">@d.DisplayName</option>
                        }
                    </select>
                </div>
                <div style="display: flex; gap: 16px; flex-wrap: wrap; align-items: center;">
                    <strong style="min-width: 80px;">Burn with</strong>
                    <label style="display: flex; gap: 6px; align-items: center; color: var(--text-primary); cursor: pointer;"
                           title="ArchivSector-OD writes the discs itself: CD-R/RW, DVD±R, DVD±RW, DVD+R DL, BD-R and BD-RE. Other discs, or a drive it can't open, go to @BurnService.FallbackName().">
                        <input type="radio" name="queue-engine" checked="@useDirect" @onchange="() => Pick(BurnService.Writer.Own)" />
                        ArchivSector-OD's own writer (recommended)
                    </label>
                    <label style="display: flex; gap: 6px; align-items: center; color: var(--text-primary); cursor: @(imgBurnPath is null ? "default" : "pointer"); opacity: @(imgBurnPath is null ? "0.6" : "1");">
                        <input type="radio" name="queue-engine" checked="@(useImgBurn && !useDirect)" disabled="@(imgBurnPath is null)" @onchange="() => Pick(BurnService.Writer.ImgBurn)" />
                        ImgBurn @(imgBurnPath is null ? "(not installed)" : "(whole disc)")
                    </label>
                    <label style="display: flex; gap: 6px; align-items: center; color: var(--text-primary); cursor: pointer;">
                        <input type="radio" name="queue-engine" checked="@(!useImgBurn && !useDirect)" @onchange="() => Pick(BurnService.Writer.Windows)" />
                        Windows (built in)
                    </label>
                </div>
                @if (useDirect)
                {
                    <span style="font-size: 12px; color: var(--text-secondary); margin: -4px 0 0 90px;">A disc the own writer doesn't handle, or a drive it can't open, is burned with @BurnService.FallbackName() instead.</span>
                }
                <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
                    <strong style="min-width: 80px;">Speed</strong>
                    <select class="settings-input" @bind="speedChoice" style="font-size: 13px;" disabled="@speedsLoading">
                        <option value="Fastest" style="background: var(--bg-panel-alt); color: var(--text-primary);">@(speeds.Count > 0 ? $"Fastest ({speeds[0].Label})" : "Fastest")</option>
                        @foreach (var sp in speeds.Skip(1))
                        {
                            <option value="@SpeedKey(sp.X)" style="background: var(--bg-panel-alt); color: var(--text-primary);">@sp.Label</option>
                        }
                    </select>
                    <span style="font-size: 12px; color: var(--text-secondary);">@SpeedHelp</span>
                </div>
                <label style="display: flex; gap: 8px; align-items: flex-start; color: var(--text-primary); cursor: pointer;">
                    <input type="checkbox" @bind="verify" style="margin-top: 3px;" />
                    <span><strong>Verify each disc</strong> (recommended)<br /><span style="font-size: 12px; color: var(--text-secondary);">Reads the disc back and compares every byte with its ISO.</span></span>
                </label>
                <label style="display: flex; gap: 8px; align-items: flex-start; color: var(--text-primary); cursor: pointer;">
                    <input type="checkbox" @bind="healthCheck" style="margin-top: 3px;" />
                    <span><strong>Disc health check after each burn</strong><br /><span style="font-size: 12px; color: var(--text-secondary);">Reads the fresh disc and shows any weak or slow areas. Adds about as long as a verify.</span></span>
                </label>
                <label style="display: flex; gap: 8px; align-items: flex-start; color: var(--text-primary); cursor: @(verify ? "pointer" : "default"); opacity: @(verify ? "1" : "0.6");">
                    <input type="checkbox" checked="@(deleteIso && verify)" disabled="@(!verify)" @onchange="e => deleteIso = (bool)(e.Value ?? false)" style="margin-top: 3px;" />
                    <span><strong>Move each ISO to the Recycle Bin</strong><br /><span style="font-size: 12px; color: var(--text-secondary);">Only after its disc is burned and verified. You can restore it from the Recycle Bin.</span></span>
                </label>
            </div>
        }

        @if (running)
        {
            <div style="display: flex; flex-direction: column; gap: 6px; margin-top: 10px;">
                <span style="font-size: 13px; color: var(--text-primary);"><strong>Disc @current of @total</strong> — @status</span>
                <div class="progress-bar"><div class="progress-fill" style="width: @F(OverallPercent)%;"></div></div>
                @if (stepPercent >= 0)
                {
                    <span style="font-size: 12px; color: var(--text-secondary);">@stepText @stepPercent.ToString("0")%</span>
                    <div class="progress-bar" style="height: 6px;"><div class="progress-fill" style="width: @F(stepPercent)%;"></div></div>
                }
                else if (stepText.Length > 0)
                {
                    <span style="font-size: 12px; color: var(--text-secondary);">@stepText</span>
                }
                <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                    <button class="bay-btn tray-btn" style="width: auto; flex: 1; opacity: @(stopAfterCurrent ? "0.85" : "1"); color: var(--text-primary);" @onclick="StopAfterThis" disabled="@stopAfterCurrent">
                        @(stopAfterCurrent ? "Stopping after this disc…" : "⏸ Stop after this disc")
                    </button>
                    <button class="bay-btn cancel-btn" style="width: auto; flex: 1;" @onclick="StopNow">✖ Stop now</button>
                </div>
            </div>
        }
        else
        {
            <div style="display: flex; gap: 6px; flex-wrap: wrap; margin-top: 10px;">
                <button class="bay-btn game" style="width: auto; padding: 0 18px;" @onclick="Start" disabled="@(Todo == 0 || string.IsNullOrEmpty(driveLetter))">
                    🔥 Burn @(HowMany(Todo, items.Any(i => i.State == ItemState.Waiting && i.IsCue)))
                </button>
                @if (items.Any(i => i.State != ItemState.Waiting))
                {
                    <button class="shortcut-btn" @onclick="ResetList" title="Lets every ISO be burned again">↺ Reset list</button>
                }
            </div>
        }

        @if (summary is not null)
        {
            <span style="font-size: 12px; margin-top: 6px; display: block; color: @SummaryColor;">@SummaryIcon @summary</span>
        }
    }
</div>

@code {
    /// <summary>The writable drives from the Burn tab's last scan.</summary>
    [Parameter] public IReadOnlyList<BurnerDrive> Drives { get; set; } = Array.Empty<BurnerDrive>();

    /// <summary>Called with the drive letter when a queue ends, so the Burn tab re-reads that drive.</summary>
    [Parameter] public EventCallback<string> Finished { get; set; }

    private enum ItemState { Waiting, Working, Done, Failed, Skipped }

    private sealed class QueueItem
    {
        public string Path = "";
        public long Bytes;
        public ItemState State = ItemState.Waiting;
        public string? Detail;
        // BIN/CUE CD image (beta 2): its layout, read when it's added.
        public CueImage? Cue;
        public bool IsCue => Path.EndsWith(".cue", StringComparison.OrdinalIgnoreCase);
        // Layer break file (beta 4): an image and where its layer 0 ends.
        public DvdLayerFile? Dvd;
        public bool IsDvd => DvdLayerFile.IsDvdFile(Path);
    }

    // A queue item from a file: an ISO, or a BIN/CUE CD image (its size is the sectors it fills).
    private static QueueItem MakeItem(string full)
    {
        var it = new QueueItem { Path = full };
        if (it.IsCue)
        {
            it.Cue = CueImage.Load(full);
            if (it.Cue.Problem is null) it.Bytes = (it.Cue.LeadOutLba + 150) * 2048L;
        }
        else if (it.IsDvd)
        {
            it.Dvd = DvdLayerFile.Load(full);
            if (it.Dvd.Problem is null) it.Bytes = it.Dvd.ImageBytes;
        }
        else
        {
            try { it.Bytes = new FileInfo(full).Length; } catch { }
        }
        return it;
    }

    private readonly List<QueueItem> items = new();
    private string? restoredNote;   // beta 4: what came back from last time
    private string savedList = "";
    private string? dropNote;   // what a drop left out (beta 4)
    private string driveLetter = "";
    private string? imgBurnPath;
    private bool useImgBurn, verify = true, healthCheck, deleteIso, settingsLoaded;
    private bool useDirect;     // v4.0: ArchivSector-OD's own writer (the default; remembered with the other choices)
    // v4.0 week 6: write speed, picked for each disc from the speeds the
    // drive offers for it (discs differ, so not one fixed speed).
    private string speedChoice = "Fastest";
    // Beta 4: the speeds the drive offers for the blank in it now, so the
    // list shows real speeds (16x, 12x, 8x...) instead of fastest / middle /
    // slowest. Each disc in the queue gets the chosen speed, or the nearest
    // slower one it offers (discs differ).
    private List<BurnEngine.WriteSpeed> speeds = new();
    private bool speedsLoading;
    private string speedsKey = "", speedsFor = "";
    private static string SpeedKey(double x) => x.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
    private string SpeedHelp => speedsLoading ? "Reading the blank disc's speeds…"
        : speeds.Count == 0 ? (speedChoice == "Fastest" ? $"The fastest the drive offers for each disc. Put a blank disc in Drive {driveLetter}: to choose a speed." : "")
        : speedChoice == "Fastest" ? $"The fastest the drive offers for each disc (the {speedsFor} in it now: {speeds[0].Label})."
        : $"Speeds the drive offers for the {speedsFor} in it now. Each disc gets this speed, or the nearest slower one it offers.";

    // The chosen drive's blank changed (or another drive was chosen): read its speeds.
    private void CheckSpeeds()
    {
        if (running) return;
        var d = Drives.FirstOrDefault(x => Letter(x) == driveLetter);
        string key = d is null ? "" : $"{driveLetter}|{d.Media.State}|{d.Media.Type}|{d.Media.FreeSectors}|{d.Busy}";
        if (key == speedsKey) return;
        speedsKey = key;
        if (d is null || d.Busy || !d.Media.CanBurnNow)
        {
            speeds = new();
            if (speedChoice != "Fastest" && d?.Busy != true) speedChoice = "Fastest";
            return;
        }
        _ = LoadSpeeds(driveLetter, d.Media.TypeName);
    }

    private async Task LoadSpeeds(string letter, string mediaName)
    {
        speedsLoading = true;
        StateHasChanged();
        List<BurnEngine.WriteSpeed> found;
        try { found = await Task.Run(() => BurnEngine.QueryWriteSpeeds(letter)); }
        catch { found = new(); }
        speedsLoading = false;
        if (letter != driveLetter || disposed) return;
        speeds = found;
        speedsFor = mediaName;
        // Keep the choice if this disc offers it too.
        if (speedChoice != "Fastest" && !speeds.Skip(1).Any(sp => SpeedKey(sp.X) == speedChoice)) speedChoice = "Fastest";
        StateHasChanged();
    }

    private bool running, stopAfterCurrent, disposed;
    private CancellationTokenSource? cts;
    private int current, total;
    private string status = "", stepText = "";
    private double stepPercent = -1;
    private string? summary;
    private bool summaryOk, summaryStopped;
    // Green when everything burned, grey when you stopped it with nothing
    // wrong, amber when a disc had a problem or was skipped.
    private string SummaryColor => summaryOk ? "var(--success)" : summaryStopped ? "var(--text-secondary)" : "var(--amber)";
    private string SummaryIcon => summaryOk ? "✅" : summaryStopped ? "⏸" : "⚠";

    private int Todo => items.Count(i => i.State == ItemState.Waiting);
    // "2 ISOs", or "2 images" once a BIN/CUE is among them (beta 4).
    private static string HowMany(int n, bool anyCue) => anyCue ? (n == 1 ? "1 image" : $"{n} images") : (n == 1 ? "1 ISO" : $"{n} ISOs");

    // Each disc counts its own steps (burn, verify, health check), so the
    // overall bar only moves forward as a disc goes from one step to the next.
    private int phaseCount = 1, phaseIndex;
    private double OverallPercent =>
        total == 0 ? 0 : Math.Clamp(100.0 * (current - 1 + (phaseIndex + Math.Max(0, stepPercent) / 100.0) / phaseCount) / total, 0, 100);

    private void NotePhase(string phase)
    {
        int idx = phase switch
        {
            "Verifying" => Math.Min(1, phaseCount - 1),
            "Checking disc health" or "Waiting for the drive" => phaseCount - 1,
            _ => 0,
        };
        if (idx > phaseIndex) phaseIndex = idx;
    }

    private static string Letter(BurnerDrive d) => d.DriveLetter.TrimEnd(':');
    private static string F(double v) => v.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
    private static string Icon(QueueItem it) => it.State switch
    {
        ItemState.Working => "⏳",
        ItemState.Done => "✅",
        ItemState.Failed => "⚠️",
        ItemState.Skipped => "⏭",
        _ => "•",
    };
    private static string Line(QueueItem it) => it.Detail
        ?? (it.Dvd is not null
            ? (it.Dvd.Problem is null ? "Layer break file: " + it.Dvd.Summary : "Layer break file: " + it.Dvd.Problem)
            : it.Cue is not null
            ? (it.Cue.Problem is null ? "BIN/CUE CD image: " + it.Cue.Summary : "BIN/CUE: " + it.Cue.Problem)
            : $"{DiscHealthService.FormatBytes(it.Bytes)} ({it.Bytes:N0} bytes)");

    protected override void OnParametersSet()
    {
        if (!settingsLoaded)
        {
            settingsLoaded = true;
            imgBurnPath = BurnService.ImgBurnPath();
            var want = BurnService.SavedWriter();
            if (want == BurnService.Writer.ImgBurn && imgBurnPath is null) want = BurnService.Writer.Own;
            useDirect = want == BurnService.Writer.Own;
            useImgBurn = want == BurnService.Writer.ImgBurn;
            deleteIso = ConfigService.Load().DeleteIsoAfterBurn;
        }
        // Keep the chosen drive; pick the first one if none is chosen yet.
        if ((string.IsNullOrEmpty(driveLetter) || !Drives.Any(d => Letter(d) == driveLetter)) && Drives.Count > 0 && !running)
            driveLetter = Letter(Drives[0]);
        CheckSpeeds();
    }

    // A program picked here is remembered (the same setting as the bays' burn screen).
    private void Pick(BurnService.Writer w)
    {
        useDirect = w == BurnService.Writer.Own;
        useImgBurn = w == BurnService.Writer.ImgBurn && imgBurnPath is not null;
        BurnService.SaveWriter(w);
    }

    private void AddIsos()
    {
        var dlg = new Microsoft.Win32.OpenFileDialog
        {
            Title = "Choose the ISOs (or BIN/CUE CD images) to burn",
            Filter = "Disc images (*.iso, *.cue, *.dvd)|*.iso;*.cue;*.dvd|ISO images (*.iso)|*.iso|BIN/CUE CD images (*.cue)|*.cue|Layer break files (*.dvd)|*.dvd|All files (*.*)|*.*",
            Multiselect = true,
        };
        if (dlg.ShowDialog(System.Windows.Application.Current.MainWindow) != true) return;
        foreach (var f in dlg.FileNames)
        {
            var full = Path.GetFullPath(f);
            if (items.Any(i => string.Equals(i.Path, full, StringComparison.OrdinalIgnoreCase))) continue;
            items.Add(MakeItem(full));
        }
        summary = null;
        dropNote = null;
    }

    protected override void OnInitialized()
    {
        FileDrop.Dropped += OnFilesDropped;
        RestoreQueue();
    }

    // ---- the list kept between runs of the app (beta 4) ----

    private static string QueueFile => Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.ApplicationData), "ArchivSector-OD", "burn-queue.txt");

    // The images not burned yet, one path per line, in order.
    private string PendingList() =>
        string.Join("\n", items.Where(i => i.State != ItemState.Done).Select(i => i.Path));

    private void RestoreQueue()
    {
        try
        {
            if (!File.Exists(QueueFile)) return;
            var paths = File.ReadAllLines(QueueFile).Select(l => l.Trim()).Where(l => l.Length > 0).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
            int gone = 0;
            foreach (var p in paths)
            {
                if (!File.Exists(p)) { gone++; continue; }
                if (items.Any(i => string.Equals(i.Path, p, StringComparison.OrdinalIgnoreCase))) continue;
                items.Add(MakeItem(p));
            }
            savedList = PendingList();
            if (items.Count > 0 || gone > 0)
                restoredNote = (items.Count > 0 ? $"{HowMany(items.Count, items.Any(i => i.IsCue))} from last time {(items.Count == 1 ? "is" : "are")} back in the queue." : "")
                    + (gone > 0 ? $" {gone} from last time {(gone == 1 ? "isn't" : "aren't")} there any more and {(gone == 1 ? "was" : "were")} left out." : "");
            restoredNote = restoredNote?.Trim();
            if (gone > 0) SaveQueue();
        }
        catch { }
    }

    // Saved whenever the list of images still to burn changes.
    private void SaveQueue()
    {
        var now = PendingList();
        if (now == savedList) return;
        savedList = now;
        try
        {
            Directory.CreateDirectory(Path.GetDirectoryName(QueueFile)!);
            if (now.Length == 0) { if (File.Exists(QueueFile)) File.Delete(QueueFile); }
            else File.WriteAllText(QueueFile, now);
        }
        catch { }
    }

    protected override void OnAfterRender(bool firstRender) => SaveQueue();

    // Files dropped from Explorer (beta 4): ISOs and .cue files are added in
    // the order dropped; a folder adds the ISOs and .cue files inside it
    // (not its subfolders). Anything else is left out and said so.
    private void OnFilesDropped(string target, IReadOnlyList<string> paths)
    {
        if (target != "burn-queue") return;
        _ = InvokeAsync(() => AddDropped(paths));
    }

    private static bool IsImageFile(string p) =>
        p.EndsWith(".iso", StringComparison.OrdinalIgnoreCase) || p.EndsWith(".cue", StringComparison.OrdinalIgnoreCase) || DvdLayerFile.IsDvdFile(p);

    private void AddDropped(IReadOnlyList<string> paths)
    {
        if (running || disposed) return;
        var files = new List<string>();
        var skipped = new List<string>();
        foreach (var p in paths)
        {
            try
            {
                if (Directory.Exists(p))
                {
                    var inside = Directory.EnumerateFiles(p).Where(IsImageFile).OrderBy(f => f, StringComparer.OrdinalIgnoreCase).ToList();
                    if (inside.Count == 0) skipped.Add(Path.GetFileName(Path.TrimEndingDirectorySeparator(p)) + " (no ISOs or .cue files in it)");
                    files.AddRange(inside);
                }
                else if (File.Exists(p) && IsImageFile(p)) files.Add(p);
                else skipped.Add(Path.GetFileName(p));
            }
            catch { skipped.Add(Path.GetFileName(p)); }
        }
        int added = 0;
        foreach (var f in files)
        {
            var full = Path.GetFullPath(f);
            if (items.Any(i => string.Equals(i.Path, full, StringComparison.OrdinalIgnoreCase))) continue;
            items.Add(MakeItem(full));
            added++;
        }
        if (added > 0) summary = null;
        dropNote = skipped.Count == 0 ? null
            : "Only ISOs, .cue and .dvd files can be queued, so this was left out: " + string.Join(", ", skipped.Take(5)) + (skipped.Count > 5 ? $" and {skipped.Count - 5} more" : "") + ".";
        StateHasChanged();
    }

    /// <summary>Adds one ISO to the list (from Build mode). Ignored if it's already there.</summary>
    public void AddIso(string path)
    {
        var full = Path.GetFullPath(path);
        if (items.Any(i => string.Equals(i.Path, full, StringComparison.OrdinalIgnoreCase))) return;
        items.Add(MakeItem(full));
        summary = null;
        Ui();
    }

    private void MoveUp(QueueItem it)
    {
        int i = items.IndexOf(it);
        if (i <= 0) return;
        items.RemoveAt(i);
        items.Insert(i - 1, it);
    }

    private void ClearList() { items.Clear(); summary = null; dropNote = null; restoredNote = null; }

    private void ResetList()
    {
        foreach (var i in items) { i.State = ItemState.Waiting; i.Detail = null; }
        summary = null;
    }

    private void StopAfterThis() => stopAfterCurrent = true;

    private void StopNow()
    {
        var owner = System.Windows.Application.Current?.MainWindow;
        var msg = "Stop the queue now?\n\nIf a disc is being written, it can't be used again.";
        var ans = owner is null
            ? MessageBox.Show(msg, "Burn queue", MessageBoxButton.YesNo, MessageBoxImage.Warning)
            : MessageBox.Show(owner, msg, "Burn queue", MessageBoxButton.YesNo, MessageBoxImage.Warning);
        if (ans == MessageBoxResult.Yes) cts?.Cancel();
    }

    private void Ui() { if (!disposed) InvokeAsync(StateHasChanged); }

    private async Task Start()
    {
        var todo = items.Where(i => i.State == ItemState.Waiting).ToList();
        if (todo.Count == 0 || string.IsNullOrEmpty(driveLetter)) return;
        var letter = driveLetter;
        var model = Drives.FirstOrDefault(d => Letter(d) == letter) is { } dr ? (dr.Vendor + " " + dr.Model).Trim() : "";
        bool wantDirect = useDirect;
        bool wantImgBurn = !wantDirect && useImgBurn && imgBurnPath is not null;
        string engineName = wantDirect ? "ArchivSector-OD's own writer" : wantImgBurn ? "ImgBurn" : "Windows";
        bool doVerify = verify, doHealth = healthCheck, doDelete = deleteIso && verify;

        running = true;
        stopAfterCurrent = false;
        summary = null;
        total = todo.Count;
        cts = new CancellationTokenSource();
        var ct = cts.Token;
        // The whole queue owns the drive: the bays and the Burn tab's scan leave it alone.
        RipActivity.Set(letter, "queue", true);
        string speedPick = speedChoice;
        LogService.Write($"{letter}:", $"Burn queue started: {HowMany(total, todo.Any(i => i.IsCue))}, {engineName}, speed {speedPick.ToLowerInvariant()}, verify {(doVerify ? "on" : "off")}, health check {(doHealth ? "on" : "off")}");
        int ok = 0, failed = 0, skipped = 0;
        bool userStopped = false;

        try
        {
            for (int n = 0; n < todo.Count; n++)
            {
                if (ct.IsCancellationRequested || stopAfterCurrent) break;
                var it = todo[n];
                current = n + 1;
                it.State = ItemState.Working;
                it.Detail = null;
                stepPercent = -1;
                phaseIndex = 0;

                // 1. Wait for a blank disc that the ISO fits on.
                status = $"Insert a blank disc in {letter}: for {Path.GetFileName(it.Path)}";
                stepText = "Waiting for a blank disc…";
                Ui();
                BurnEngine.BlankInfo? blank = null;
                while (!ct.IsCancellationRequested && !stopAfterCurrent)
                {
                    blank = await Task.Run(() => BurnService.QueryBlank(letter));
                    if (blank is not null) break;
                    try { await Task.Delay(3000, ct); } catch (OperationCanceledException) { }
                }
                if (blank is null) { it.State = ItemState.Waiting; break; }

                // This disc's program: our own writer doesn't write every kind
                // of disc yet, so those go to ImgBurn (or Windows without it).
                bool direct = wantDirect && BurnEngine.DirectWriteSupports(blank.MediaType);
                bool imgBurn = wantImgBurn || (wantDirect && !direct && imgBurnPath is not null);
                if (wantDirect && !direct)
                    LogService.Write($"{letter}:", $"Burn queue: ArchivSector-OD's own writer doesn't write {blank.MediaType} discs yet; burning this one with {(imgBurn ? "ImgBurn" : "Windows")}");

                // A BIN/CUE CD image needs a CD, and our own writer or ImgBurn (Windows can't).
                if (it.IsCue)
                {
                    string? cueSkip = null;
                    bool cd = blank.MediaType is "CD-R" or "CD-RW";
                    bool ownCan = cd && it.Cue?.Problem is null;
                    if (!cd) cueSkip = $"Skipped: a BIN/CUE image is a CD image, and the blank disc in the drive is a {blank.MediaType}.";
                    else if (wantDirect || !imgBurn) { direct = ownCan; imgBurn = !ownCan && imgBurnPath is not null; }
                    if (cueSkip is null && !direct && !imgBurn)
                        cueSkip = "Skipped: " + (it.Cue?.Problem ?? "ArchivSector-OD's own writer can't burn this image") + " Windows can't burn BIN/CUE, and ImgBurn isn't installed.";
                    if (cueSkip is not null)
                    {
                        it.State = ItemState.Skipped;
                        it.Detail = cueSkip;
                        skipped++;
                        LogService.Write($"{letter}:", "Burn queue: skipped " + it.Path + " — " + it.Detail);
                        continue;   // the blank disc stays in for the next one
                    }
                }

                // A layer break file (beta 4) needs our own writer or ImgBurn (Windows can't set a layer break).
                if (it.IsDvd)
                {
                    string? dvdSkip = it.Dvd?.Problem is not null ? "Skipped: " + it.Dvd.Problem : null;
                    if (dvdSkip is null && !direct && !imgBurn)
                    {
                        if (BurnEngine.DirectWriteSupports(blank.MediaType)) direct = true;
                        else if (imgBurnPath is not null) imgBurn = true;
                        else dvdSkip = "Skipped: Windows can't set a layer break, and neither ArchivSector-OD's own writer nor ImgBurn can burn this disc.";
                    }
                    if (dvdSkip is not null)
                    {
                        it.State = ItemState.Skipped;
                        it.Detail = dvdSkip;
                        skipped++;
                        LogService.Write($"{letter}:", "Burn queue: skipped " + it.Path + " — " + it.Detail);
                        continue;
                    }
                }

                bool wholeDisc = imgBurn || direct;
                long limit = wholeDisc ? BurnEngine.FullDiscBytes(blank.MediaType, Math.Max(blank.TotalBytes, blank.FreeBytes)) : blank.FreeBytes;
                if (it.Bytes > limit)
                {
                    it.State = ItemState.Skipped;
                    it.Detail = $"Skipped: too big for the {blank.MediaType} in the drive ({DiscHealthService.FormatBytes(it.Bytes)}, the disc takes {DiscHealthService.FormatBytes(limit)}" +
                                (wholeDisc ? ")." : " with Windows; ImgBurn and ArchivSector-OD's own writer can use the whole disc).");
                    skipped++;
                    LogService.Write($"{letter}:", "Burn queue: skipped " + it.Path + " — " + it.Detail);
                    continue;   // the blank disc stays in for the next ISO
                }

                // This disc's speed (0 = fastest). An Xbox 360 game left at
                // "Fastest" gets the slowest the disc offers instead (beta 4):
                // fast burns are what give "Disc Unrecognizable" on the console.
                string? xbox = it.IsCue ? null : BurnEngine.XboxGameKind(it.Dvd?.ImagePath ?? it.Path);
                double speedX = speedPick == "Fastest" ? 0 : await Task.Run(() => BurnEngine.PickSpeed(letter, speedPick));
                if (xbox is not null && speedPick == "Fastest")
                {
                    speedX = await Task.Run(() => BurnEngine.PickSpeed(letter, "Slowest"));
                    LogService.Write($"{letter}:", speedX > 0
                        ? $"Burn queue: Xbox 360 {xbox} game, so it's burned at the slowest speed this {blank.MediaType} offers ({BurnEngine.SpeedText(speedX)})"
                        : $"Burn queue: Xbox 360 {xbox} game; this {blank.MediaType} offers only one speed");
                }
                else if (speedPick != "Fastest")
                    LogService.Write($"{letter}:", speedX > 0
                        ? $"Burn queue: {speedPick}x asked; this {blank.MediaType} is burned at {BurnEngine.SpeedText(speedX)}"
                        : $"Burn queue: {speedPick}x asked; this {blank.MediaType} is burned at its fastest (it offers nothing slower that fits, or only one speed)");

                // 2. Burn (and verify).
                phaseIndex = 0;
                phaseCount = 1 + (doVerify && !imgBurn ? 1 : 0) + (doHealth ? 1 : 0);
                status = $"Burning {Path.GetFileName(it.Path)} to {blank.MediaType}";
                stepText = imgBurn ? "Burning with ImgBurn (progress in its window)…" : "Preparing…";
                Ui();
                var reporter = new Progress<BurnEngine.Progress>(p =>
                {
                    stepText = p.Phase + "…";
                    NotePhase(p.Phase);
                    stepPercent = p.Percent;
                    Ui();
                });
                var r = await BurnService.BurnAsync(letter, it.Path, doVerify, Path.GetFileNameWithoutExtension(it.Path), model, reporter, ct, imgBurn, doDelete && !it.IsCue && !it.IsDvd, direct, speedX);
                stepPercent = -1;
                LogService.Write($"{letter}:", "Burn queue: " + it.Path + " — " + r.Message);

                if (!r.Burned)
                {
                    it.State = ItemState.Failed;
                    it.Detail = r.Message;
                    // An XGD3 game refused on a drive BurnerMAX hasn't worked on: point to one it has (beta 4).
                    if (xbox == "XGD3" && r.NoFallback && BurnService.BurnerMaxHint(model) is string hint) it.Detail += " " + hint;
                    failed++;
                    if (r.Cancelled || ct.IsCancellationRequested) break;
                }
                else
                {
                    bool good = r.Verified != false;
                    string detail = r.Message;

                    // 3. Optional disc health check on the fresh disc.
                    if (doHealth && !ct.IsCancellationRequested)
                    {
                        status = $"Checking the burned disc ({Path.GetFileName(it.Path)})";
                        stepText = "Waiting for the drive…";
                        Ui();
                        var health = await BurnService.HealthCheckAfterBurnAsync(letter, Path.GetFileNameWithoutExtension(it.Path), model, reporter, ct);
                        stepPercent = -1;
                        if (health is not null)
                        {
                            detail += " " + BurnService.HealthLine(health);
                            if (health.Verdict == DiscHealthService.Level.Damaged) good = false;
                        }
                    }

                    it.State = good ? ItemState.Done : ItemState.Failed;
                    it.Detail = detail;
                    if (good) ok++; else failed++;
                }

                // 4. Eject, ready for the next blank (not after the last one).
                bool more = todo.Skip(n + 1).Any() && !stopAfterCurrent && !ct.IsCancellationRequested;
                if (more || r.Burned)
                {
                    stepText = "Ejecting…";
                    Ui();
                    await Task.Run(() => TrayControlService.EjectWithoutVolume(letter));
                }
            }
        }
        catch (Exception ex)
        {
            LogService.Write($"{letter}:", "Burn queue stopped by an error: " + ex.Message);
            summary = "The queue stopped because of an error: " + ex.Message;
        }
        finally
        {
            userStopped = stopAfterCurrent || cts.IsCancellationRequested;
            RipActivity.Set(letter, "queue", false);
            foreach (var i in todo.Where(i => i.State == ItemState.Working)) { i.State = ItemState.Waiting; i.Detail = null; }
            cts.Dispose();
            cts = null;
            running = false;
            stepText = "";
            stepPercent = -1;
        }

        int left = todo.Count(i => i.State == ItemState.Waiting);
        bool clean = failed == 0 && skipped == 0;
        summary ??= (userStopped && left > 0 ? "Stopped. " : "") +
                    $"{ok} disc(s) burned{(failed > 0 ? $", {failed} with a problem" : "")}{(skipped > 0 ? $", {skipped} skipped" : "")}" +
                    (left > 0 ? $", {left} still to do." : ".");
        summaryOk = clean && left == 0;
        summaryStopped = clean && left > 0 && userStopped;
        LogService.Write($"{letter}:", "Burn queue finished: " + summary);
        try { if (ConfigService.Load().SoundAlerts) System.Media.SystemSounds.Exclamation.Play(); } catch { }
        Ui();
        // The Burn tab still shows the drive as "in use" from its last scan.
        if (!disposed) await Finished.InvokeAsync(letter);
    }

    // Leaving the tab never stops a running queue; it carries on.
    public void Dispose()
    {
        disposed = true;
        FileDrop.Dropped -= OnFilesDropped;
    }
}
