    // Unattended Mode has no one to answer "overwrite?", so instead of
    // replacing an existing archive it appends " (2)", " (3)", etc. --
    // ported from the Python app's force_full collision handling.
    private string UniqueUnattendedName(string dir, string baseName)
    {
        var name = baseName;
        int n = 2;
        while (Directory.Exists(Path.Combine(dir, name)) || File.Exists(Path.Combine(dir, $"{name}.iso")))
        {
            name = $"{baseName} ({n})";
            n++;
        }
        if (name != baseName)
            AddLog($"Unattended Mode: '{baseName}' already exists here -- saving as '{name}' instead.");
        return name;
    }

    // Full backups (Blu-ray backup, DVD MakeMKV backup, DVD raw ISO)
    // are sorted into a size-based subfolder (BD-25 / BD-50 / BD-100 /
    // DVD-5 / DVD-9) using the same capacity classification shown on
    // the card. The Python app only did this in Unattended Mode; here
    // it also applies whenever Auto-categorize is on, so attended and
    // unattended backups end up in the same place. Falls back to plain
    // "BD" / "DVD" if no size could be classified.
    private string SizeSubfolder(bool isBd)
    {
        var m = System.Text.RegularExpressions.Regex.Match(FormatLabel ?? "", @"\b(BD|DVD)-\d+\b",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        return m.Success ? m.Value.ToUpperInvariant() : (isBd ? "BD" : "DVD");
    }

    // ---- Console detection from Redumper's log ----

    // Original Xbox and Xbox 360 discs hide their game files from
    // Windows, so they can't be identified before the dump. Redumper
    // can read them on a drive that supports it (e.g. OmniDrive
    // firmware) and writes a line like
    //   omnidrive: XGD detected (version: 2, security sector: incomplete)
    // to "<name>.log". XGD version 1 = Original Xbox, 2 or 3 = Xbox 360.
    private static readonly System.Text.RegularExpressions.Regex XgdRegex =
        new(@"XGD detected \(version:\s*(\d+)(?:,\s*security sector:\s*([a-z]+))?",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

    // After a successful game dump: if the console wasn't known, read
    // Redumper's log. When it names an Xbox console, record it, and if
    // the dump landed in Games\General_Games (no bay label), move it
    // into Games\<console> instead.
    private void ApplyRedumperLogDetection(AppConfig config, string operationLabel)
    {
        if (!string.IsNullOrWhiteSpace(GameSystem)) return;
        if (lastGameFolder is null || lastGameName is null) return;

        string logText;
        try
        {
            var logPath = Path.Combine(lastGameFolder, $"{lastGameName}.log");
            if (!File.Exists(logPath)) return;
            logText = File.ReadAllText(logPath);
        }
        catch { return; }

        var matches = XgdRegex.Matches(logText);
        if (matches.Count == 0) return;
        var m = matches[matches.Count - 1]; // newest run in the log

        var system = m.Groups[1].Value == "1" ? "Original Xbox" : "Xbox 360";
        logGameSystem = system;
        AddLog($"{operationLabel}: Redumper identified this as an {system} disc (XGD{m.Groups[1].Value}).");

        if (m.Groups[2].Success && !m.Groups[2].Value.Equals("complete", StringComparison.OrdinalIgnoreCase))
            AddLog($"[NOTE] Redumper reports the Xbox security sector as \"{m.Groups[2].Value}\" -- the game data is dumped, but this dump may not match Redump's database.");

        // Only re-sort dumps that went to General_Games because the
        // console wasn't known. A bay label means the user chose the
        // folder, and with Auto-categorize off there are no console
        // folders at all.
        if (!config.AutoCategorize || !string.IsNullOrWhiteSpace(customLabel)) return;

        var generalDir = Path.GetDirectoryName(lastGameFolder);
        var fallbackName = generalDir is null ? "" : Path.GetFileName(generalDir);
        if (generalDir is null
            || !(fallbackName.Equals("General_Games", StringComparison.OrdinalIgnoreCase)
                 || fallbackName.Equals("PC_and_Other", StringComparison.OrdinalIgnoreCase))) return;
        var gamesDir = Path.GetDirectoryName(generalDir);
        if (gamesDir is null) return;

        var consoleDir = Path.Combine(gamesDir, FileNamingService.SanitizeFilename(system));
        var folderName = Path.GetFileName(lastGameFolder);
        var target = Path.Combine(consoleDir, folderName);
        int n = 2;
        while (Directory.Exists(target) || File.Exists(target))
        {
            target = Path.Combine(consoleDir, $"{folderName} ({n})");
            n++;
        }

        try
        {
            Directory.CreateDirectory(consoleDir);
            Directory.Move(lastGameFolder, target);
        }
        catch (Exception ex)
        {
            AddLog($"Couldn't move the dump into {consoleDir}: {ex.Message} -- it stays where it is.");
            return;
        }

        if (lastGameIso is not null)
            lastGameIso = Path.Combine(target, Path.GetFileName(lastGameIso));
        lastGameFolder = target;
        if (redumperResult is not null && redumperResult.Success)
            redumperResult.IsoPath = lastGameIso;

        // Leave the General_Games / PC_and_Other folder behind only if it's now empty.
        try
        {
            if (!Directory.EnumerateFileSystemEntries(generalDir).Any())
                Directory.Delete(generalDir);
        }
        catch { /* not important */ }

        AddLog($"Moved to {target}");
    }

    // Backup for an Xbox disc dumped through the DVD menu's Raw Sector
    // ISO option: if Redumper's log has an "XGD detected" line, record
    // the console and (with Auto-categorize on) move the dump from
    // DVD_Movies into Games\<console> -- or the bay label's folder.
    private void MoveXboxDumpOutOfDvd(AppConfig config, string outputBase, string outputFolder, string isoName, string operationLabel)
    {
        string logText;
        try
        {
            var logPath = Path.Combine(outputFolder, $"{isoName}.log");
            if (!File.Exists(logPath)) return;
            logText = File.ReadAllText(logPath);
        }
        catch { return; }

        var matches = XgdRegex.Matches(logText);
        if (matches.Count == 0) return;
        var m = matches[matches.Count - 1];

        var system = m.Groups[1].Value == "1" ? "Original Xbox" : "Xbox 360";
        logGameSystem = system;
        AddLog($"{operationLabel}: Redumper identified this as an {system} disc (XGD{m.Groups[1].Value}), not a DVD movie.");
        if (m.Groups[2].Success && !m.Groups[2].Value.Equals("complete", StringComparison.OrdinalIgnoreCase))
            AddLog($"[NOTE] Redumper reports the Xbox security sector as \"{m.Groups[2].Value}\" -- the game data is dumped, but this dump may not match Redump's database.");

        if (!config.AutoCategorize) return;

        var sysFolder = !string.IsNullOrWhiteSpace(customLabel)
            ? FileNamingService.SanitizeFilename(customLabel)
            : FileNamingService.SanitizeFilename(system);
        var consoleDir = Path.Combine(outputBase, CategoryFolder(config, "Games"), sysFolder);
        var folderName = Path.GetFileName(outputFolder);
        var target = Path.Combine(consoleDir, folderName);
        int n = 2;
        while (Directory.Exists(target) || File.Exists(target))
        {
            target = Path.Combine(consoleDir, $"{folderName} ({n})");
            n++;
        }

        try
        {
            Directory.CreateDirectory(consoleDir);
            Directory.Move(outputFolder, target);
        }
        catch (Exception ex)
        {
            AddLog($"Couldn't move the dump into {consoleDir}: {ex.Message} -- it stays where it is.");
            return;
        }

        if (redumperResult is not null && redumperResult.IsoPath is not null)
            redumperResult.IsoPath = Path.Combine(target, Path.GetFileName(redumperResult.IsoPath));
        AddLog($"Moved to {target}");
    }

    // Backup for music CDs the app didn't recognize before the dump (they
    // were dumped as unrecognized data discs into Games\PC_and_Other).
    // Redumper's log lists the disc's tracks as "track 1 {  audio }" or
    // "track 1 {  data }"; when every track is audio, it's a music CD, so
    // the dump moves to Music_CDs and History records "Audio CD". Mixed
    // discs (e.g. PS1 games with CD-audio tracks) aren't touched.
    private static readonly System.Text.RegularExpressions.Regex TocTrackRegex =
        new(@"^\s*track\s+\d+\s*\{\s*(audio|data)\b",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.Multiline);

    private void MoveMusicCdFromLog(AppConfig config, string outputBase, string operationLabel)
    {
        if (Category != DiscCategory.Unknown || lastGameFolder is null || lastGameName is null) return;

        string logText;
        try
        {
            var logPath = Path.Combine(lastGameFolder, $"{lastGameName}.log");
            if (!File.Exists(logPath)) return;
            logText = File.ReadAllText(logPath);
        }
        catch { return; }

        var tracks = TocTrackRegex.Matches(logText);
        if (tracks.Count == 0) return;
        foreach (System.Text.RegularExpressions.Match t in tracks)
            if (!t.Groups[1].Value.Equals("audio", StringComparison.OrdinalIgnoreCase)) return;

        logAudioCd = true;
        AddLog($"{operationLabel}: Redumper shows only audio tracks -- this is a music CD.");

        if (!config.AutoCategorize || !string.IsNullOrWhiteSpace(customLabel)) return;

        var musicDir = Path.Combine(outputBase, CategoryFolder(config, "Music_CDs"));
        var folderName = Path.GetFileName(lastGameFolder);
        var target = Path.Combine(musicDir, folderName);
        int n = 2;
        while (Directory.Exists(target) || File.Exists(target))
        {
            target = Path.Combine(musicDir, $"{folderName} ({n})");
            n++;
        }

        var oldParent = Path.GetDirectoryName(lastGameFolder);
        try
        {
            Directory.CreateDirectory(musicDir);
            Directory.Move(lastGameFolder, target);
        }
        catch (Exception ex)
        {
            AddLog($"Couldn't move the dump into {musicDir}: {ex.Message} -- it stays where it is.");
            return;
        }

        if (lastGameIso is not null)
            lastGameIso = Path.Combine(target, Path.GetFileName(lastGameIso));
        lastGameFolder = target;
        if (redumperResult is not null && redumperResult.Success)
            redumperResult.IsoPath = lastGameIso;

        try
        {
            if (oldParent is not null && !Directory.EnumerateFileSystemEntries(oldParent).Any())
                Directory.Delete(oldParent);
        }
        catch { /* not important */ }

        AddLog($"Moved to {target}");
    }

