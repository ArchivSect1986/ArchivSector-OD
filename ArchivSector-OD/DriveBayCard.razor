    private async Task ToggleTray()
    {
        isTrayBusy = true;
        trayMessage = null;
        StateHasChanged();

        bool wasOpen = trayIsOpen;
        AddLog(wasOpen ? "Close tray requested" : "Eject requested");
        var result = await Task.Run(() => wasOpen
            ? TrayControlService.Close(DriveLetter)
            : TrayControlService.Eject(DriveLetter));

        isTrayBusy = false;
        trayMessage = $"{(wasOpen ? "Close" : "Eject")}: {result.Detail}";
