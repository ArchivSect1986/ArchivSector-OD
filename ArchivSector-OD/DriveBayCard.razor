    private void LoadCoverDataUri()
    {
        try
        {
            if (hasCachedCover && File.Exists(cachedArt!.CoverPath))
            {
                var bytes = File.ReadAllBytes(cachedArt.CoverPath);
                coverDataUri = $"data:image/jpeg;base64,{Convert.ToBase64String(bytes)}";
            }
            else
            {
                coverDataUri = null;
            }
        }
        catch
        {
            coverDataUri = null;
        }
    }

    private async Task AutoFetchArtSilently()
    {
        if (string.IsNullOrWhiteSpace(VolumeTitle)) return;
        var config = ConfigService.Load();
        if (!config.AutoFetchMetadataArt) return;

        // TMDB-only: the iTunes no-key fallback was removed after it
        // stopped returning movie results at all. With no TMDB key,
        // auto-fetch just skips and says why in the log.
        if (string.IsNullOrWhiteSpace(config.TmdbApiKey))
        {
            AddLog("Auto-fetch skipped: no TMDB API key set (add a free one in Settings).");
            return;
        }

        var query = MetadataFetchService.BuildSearchQuery(VolumeTitle, Category);
        AddLog($"Auto-fetching artwork for \"{query}\" via TMDB…");

        try
        {
            var results = await MetadataFetchService.SearchTmdb(query, config.TmdbApiKey);

            if (results.Count == 0)
            {
                AddLog($"Auto-fetch: no results found for \"{query}\".");
                return;
            }

            var top = results[0];
            cachedArt = await MetadataFetchService.SaveArtworkAndMetadata(ArtCacheName, top);
            LoadCoverDataUri();
            AddLog(hasCachedCover
                ? $"Auto-fetch: saved \"{top.Title}\" ({top.Source})"
                : $"Auto-fetch: saved metadata for \"{top.Title}\" but no cover image was available -- will retry next insert.");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            AddLog($"Auto-fetch failed: {ex.Message}");
        }
    }

    private async Task FetchMetadata()
    {
        if (string.IsNullOrWhiteSpace(VolumeTitle)) return;

        var config = ConfigService.Load();
        var query = MetadataFetchService.BuildSearchQuery(VolumeTitle, Category);
        AddLog($"Metadata search: \"{query}\"");

        var window = new MetadataSearchWindow(query, Category, config)
        {
            Owner = System.Windows.Application.Current.MainWindow
        };
        window.Show();
        var chosen = await window.ResultTask;

        if (chosen is null)
        {
            AddLog("Metadata search: cancelled, nothing saved");
            return;
        }

        AddLog($"Metadata search: saving \"{chosen.Title}\" ({chosen.Source}) to art cache");
        cachedArt = await MetadataFetchService.SaveArtworkAndMetadata(ArtCacheName, chosen);
        LoadCoverDataUri();
        AddLog($"Metadata saved: {MetadataFetchService.GetArtCacheDir(ArtCacheName)}");
        StateHasChanged();
    }

    private void OpenArtCacheFolder()
    {
        if (string.IsNullOrWhiteSpace(VolumeTitle)) return;
        try
        {
            var dir = MetadataFetchService.GetArtCacheDir(ArtCacheName);
            if (Directory.Exists(dir))
                Process.Start(new ProcessStartInfo { FileName = dir, UseShellExecute = true });
        }
        catch (Exception ex)
        {
            AddLog($"Couldn't open art cache folder: {ex.Message}");
        }
    }

    private void AddLog(string text)
    {
        logLines.Add($"[{DateTime.Now:HH:mm:ss}] {text}");
        if (logLines.Count > 200) logLines.RemoveAt(0);
    }

    private void RecordHistory(string operation, string outputPath, string sha1 = "", string md5 = "", string redumpMatch = "")
    {
        HistoryService.Append(new HistoryEntry
        {
            Timestamp = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"),
            DriveLetter = DriveLetter,
            DriveModel = DriveModel,
            // A game dump records the file name it was saved under, so a
            // name typed in the bay's name box shows up in History.
            Title = !string.IsNullOrEmpty(lastGameName)
                ? lastGameName
                : string.IsNullOrEmpty(VolumeTitle) ? "UNKNOWN" : VolumeTitle,
            // Game dumps record the detected console (e.g. "PlayStation 2")
            // as their System, like the Python app did, so History's
            // per-system stats count PS1/PS2/PS3 separately.
            System = !string.IsNullOrWhiteSpace(EffectiveGameSystem) ? EffectiveGameSystem
                : IsAudioDump
                    ? (DiscDetectionService.IsMusicFileDisc(DriveLetter.TrimEnd(':', '\\') + ":\\") ? "Music CD (files)" : "Audio CD")
                : operation,
            Serial = Serial,
            AacsVersion = AacsVersion,
            OutputPath = outputPath,
            Capacity = CapacityLabel,
            Sha1 = sha1,
            Md5 = md5,
            RedumpMatch = redumpMatch,
        });
    }

