    private void OnGameNameInput(ChangeEventArgs e)
    {
        gameNameDraft = e.Value?.ToString() ?? "";
        gameNameNote = null;
    }

    private void OnGameNameKeydown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !isRunning && !isVerifying && CanRenameFinished)
            RenameFinishedGame();
    }

    // Turns what was typed into a safe file/folder name, or null if
    // nothing usable is left.
    private static string? CleanGameName(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return null;
        var cleaned = FileNamingService.SanitizeFilename(text.Trim()).Trim().TrimEnd('.', ' ');
        return string.IsNullOrWhiteSpace(cleaned) ? null : cleaned;
    }

    private bool CanRenameFinished =>
        lastGameFolder is not null
        && CleanGameName(gameNameDraft) is string wanted
        && wanted != lastGameName;

    private void RenameFinishedGame()
    {
        var wanted = CleanGameName(gameNameDraft);
        if (wanted is null || wanted == lastGameName) return;

        var oldIso = lastGameIso;
        if (RenameGameOutput(wanted))
        {
            if (oldIso is not null && lastGameIso is not null)
                HistoryService.UpdateRenamed(oldIso, lastGameIso, wanted);
            gameNameNote = $"✓ Renamed to '{wanted}'";
        }
        StateHasChanged();
    }

    // Renames a finished game dump: every file in its folder that starts
    // with the old name (.iso, .log, .cue, "Name (Track 1).bin", ...),
    // the file names written inside any .cue sheet, and then the folder
    // itself. Returns false (with a note on the bay) if it couldn't.
    private bool RenameGameOutput(string newName)
    {
        if (lastGameFolder is null || lastGameName is null) return false;
        var parent = Path.GetDirectoryName(lastGameFolder);
        if (parent is null) return false;

        var oldName = lastGameName;
        var oldFolder = lastGameFolder;
        var newFolder = Path.Combine(parent, newName);
        bool caseOnly = string.Equals(newFolder, oldFolder, StringComparison.OrdinalIgnoreCase);

        if (!caseOnly && (Directory.Exists(newFolder) || File.Exists(newFolder)))
        {
            gameNameNote = $"⚠ '{newName}' already exists in {parent} -- pick a different name.";
            AddLog($"Rename: '{newName}' already exists, nothing was renamed.");
            return false;
        }

        try
        {
            foreach (var file in Directory.GetFiles(oldFolder))
            {
                var fileName = Path.GetFileName(file);
                if (!fileName.StartsWith(oldName, StringComparison.OrdinalIgnoreCase)) continue;

                if (Path.GetExtension(file).Equals(".cue", StringComparison.OrdinalIgnoreCase))
                {
                    var cue = File.ReadAllText(file);
                    File.WriteAllText(file, cue.Replace($"\"{oldName}", $"\"{newName}"));
                }

                var target = Path.Combine(oldFolder, newName + fileName.Substring(oldName.Length));
                if (!string.Equals(file, target, StringComparison.Ordinal))
                    File.Move(file, target);
            }

            if (!string.Equals(newFolder, oldFolder, StringComparison.Ordinal))
            {
                if (caseOnly)
                {
                    // Windows won't rename a folder when only the capital
                    // letters change, so go through a temporary name.
                    var temp = oldFolder + "_renaming";
                    Directory.Move(oldFolder, temp);
                    Directory.Move(temp, newFolder);
                }
                else
                {
                    Directory.Move(oldFolder, newFolder);
                }
            }
        }
        catch (Exception ex)
        {
            gameNameNote = $"⚠ Couldn't finish renaming: {ex.Message} (some files may already have the new name)";
            AddLog($"Rename failed: {ex.Message}");
            return false;
        }

        if (lastGameIso is not null)
            lastGameIso = Path.Combine(newFolder, newName + Path.GetFileName(lastGameIso).Substring(oldName.Length));

        lastGameFolder = newFolder;
        lastGameName = newName;
        gameNameDraft = newName;
        lastOutputFolder = lastGameIso ?? newFolder;
        if (redumperResult is not null && redumperResult.Success)
            redumperResult.IsoPath = lastGameIso;

        AddLog($"Renamed to '{newName}': {lastGameIso ?? newFolder}");
        return true;
    }

