    private void ResetResultState()
    {
        selectedMode = null;
        makeMkvResult = null;
        backupResult = null;
        movieOnlyResult = null;
        redumperResult = null;
        wasCancelled = false;
        notBuiltMessage = null;
        preflightBlockedReason = null;
        currentProcess = null;
        runningKind = "makemkv";
        isVerifying = false;
        verificationMessage = null;
        trimMessage = null;
