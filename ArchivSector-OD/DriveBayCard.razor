    private void StartProgressTimer(string folder, long target)
    {
        progressFolder = folder;
        targetBytes = target;
        writtenBytes = 0;
        progressPercent = target > 0 ? 0 : null;
        progressTimer = new Timer(_ => InvokeAsync(() =>
        {
            if (progressFolder is null) return;
            writtenBytes = MakeMkvService.GetFolderSizeBytes(progressFolder);
            progressPercent = targetBytes > 0
                ? Math.Clamp((int)Math.Round((double)writtenBytes / targetBytes * 100), 0, 100)
                : (int?)null;
            StateHasChanged();
        }), null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(2));
    }

    private void StopProgressTimer()
    {
        progressTimer?.Dispose();
        progressTimer = null;
        progressFolder = null;
    }

    private void CancelRun()
    {
        wasCancelled = true;
        AddLog("Cancel requested by user");
        try { currentProcess?.Kill(entireProcessTree: true); }
        catch { /* already exited, or couldn't be killed -- either way, proceed */ }
    }

    // Ported from the Python app's _start_pipeline_gated(): rips
    // started by clicking a button go through the same Multi-Drive
    // Batch Sync gate as auto-starts and Retry, so the concurrent-rip
    // limit applies no matter how a rip was started. A click that
    // can't start right away is queued and starts itself once a slot
    // frees up, instead of being refused.
    private async Task StartGated(Func<Task> action)
    {
        var config = ConfigService.Load();
        if (!config.MultiDriveBatchSync)
        {
            await action();
            return;
        }

        bool claimed = BatchSyncService.ClaimOrQueue(DriveLetter, config.MaxConcurrentRips, async () =>
        {
            await InvokeAsync(action);
            BatchSyncService.ReleaseSlot();
        });
        if (!claimed)
        {
            showModeDialog = false;
            AddLog($"Multi-Drive Batch Sync: queued (all {Math.Max(1, config.MaxConcurrentRips)} slot(s) busy) -- will start once a slot frees up.");
            StateHasChanged();
            return;
        }
        await action();
        BatchSyncService.ReleaseSlot();
    }

    // The mode dialog's Blu-ray/DVD choice is captured at click time,
    // so a queued rip still runs as the disc type that was clicked even
    // if the dialog is reopened for something else before it starts.
    private Task ManualFullBackup()
    {
        var kind = dialogKind;
        showModeDialog = false;
        return StartGated(() => { dialogKind = kind; return RunFullBackup(); });
    }

    private Task ManualMovieOnly()
    {
        var kind = dialogKind;
        showModeDialog = false;
        return StartGated(() => { dialogKind = kind; return PickMovieOnly(); });
    }

    // Now goes through BatchSyncService the same as TryAutoStart, so a
    // retry can't bypass Multi-Drive Batch Sync's concurrent-rip cap.
    // The action is captured into a local before any queueing, since
    // lastAction itself gets reassigned by the very operation it
    // points to (e.g. RunFullBackup sets lastAction = RunFullBackup
    // right before returning) -- referencing the field directly inside
    // a callback that might fire much later, after further reassignment,
    // would risk retrying the wrong thing.
    private async Task RetryLast()
    {
        var actionToRetry = lastAction;
        if (actionToRetry is null) return;

        var config = ConfigService.Load();
        AddLog("Retrying last operation");

        if (config.MultiDriveBatchSync)
        {
            bool claimed = BatchSyncService.ClaimOrQueue(DriveLetter, config.MaxConcurrentRips, async () =>
            {
                await InvokeAsync(actionToRetry);
                BatchSyncService.ReleaseSlot();
            });
            if (!claimed)
            {
                AddLog($"Multi-Drive Batch Sync: retry queued (all {Math.Max(1, config.MaxConcurrentRips)} slot(s) busy) -- will start once a slot frees up.");
                StateHasChanged();
                return;
            }
            await actionToRetry();
            BatchSyncService.ReleaseSlot();
        }
        else
        {
            await actionToRetry();
        }
    }

    private async Task VerifyOutput(string isoPath)
    {
        isVerifying = true;
        AddLog("Computing SHA1/MD5…");
        StateHasChanged();

        try
        {
            var (sha1, md5) = await Task.Run(() => VerificationService.ComputeChecksums(isoPath));
            if (sha1 is null)
            {
                verificationMessage = "⚠ Couldn't compute checksums (file not found?)";
                verificationColor = "var(--danger)";
                AddLog(verificationMessage);
                return;
            }

            lastSha1 = sha1;
            lastMd5 = md5 ?? "";
            AddLog($"SHA1: {sha1}");

            var match = await Task.Run(() => VerificationService.VerifyAgainstRedump(sha1));
            if (match is not null)
            {
                lastRedumpMatch = match.Name;
                verificationMessage = $"✓ Redump match: {match.Name} (from {match.SourceDat})";
                verificationColor = "var(--success)";
            }
            else if (!VerificationService.HasAnyDatImported())
            {
                lastRedumpMatch = "No DAT imported";
                verificationMessage = "ℹ Redump: no DAT file imported yet (see Settings)";
                verificationColor = "var(--text-muted)";
            }
            else
            {
                lastRedumpMatch = "No match";
                verificationMessage = "⚠ No Redump match found for this dump (doesn't necessarily mean it's bad)";
                verificationColor = "var(--amber)";
            }
            AddLog(verificationMessage);
        }
        finally
        {
            isVerifying = false;
            StateHasChanged();
        }
    }

    // Movie-Only always gets a real checksum, but the Redump *match*
    // step is deliberately skipped -- Redump only catalogs raw,
    // unmodified disc dumps, and a re-muxed .mkv could never match
    // one no matter how good the rip is, so checking anyway would
    // misleadingly read as a bad rip when nothing is wrong.
    private async Task VerifyMovieOnlyOutput(string mkvPath)
    {
        isVerifying = true;
        AddLog("Computing SHA1/MD5…");
        StateHasChanged();

        try
        {
            var (sha1, md5) = await Task.Run(() => VerificationService.ComputeChecksums(mkvPath));
            if (sha1 is null)
            {
                verificationMessage = "⚠ Couldn't compute checksums (file not found?)";
                verificationColor = "var(--danger)";
                AddLog(verificationMessage);
                return;
            }

            lastSha1 = sha1;
            lastMd5 = md5 ?? "";
            lastRedumpMatch = "N/A (re-muxed)";
            AddLog($"SHA1: {sha1}");
            AddLog("Redump check skipped: this is a re-muxed .mkv, not a raw disc dump, so its hash could never match Redump's database.");
            verificationMessage = "ℹ Checksums computed (Redump check N/A -- re-muxed file)";
            verificationColor = "var(--text-muted)";
        }
        finally
        {
            isVerifying = false;
            StateHasChanged();
        }
    }

    private async Task RunRedumperDump(string folderPrefix, string operationLabel, string category)
    {
        showModeDialog = false;
        ResetResultState();
        selectedMode = folderPrefix == "Game" ? "Game Disc" : "DVD Movie Disc (Raw Sector ISO)";
        AddLog($"{operationLabel}: locating redumper.exe");
        StateHasChanged();

        var config = ConfigService.Load();
        var exe = RedumperService.FindExecutable(config.RedumperPathOverride);

        string? imgBurnFallbackExe = null;
        if (exe is null && folderPrefix == "DVD_RawISO")
        {
            AddLog($"{operationLabel}: redumper.exe not found, checking for ImgBurn fallback");
            imgBurnFallbackExe = ImgBurnService.FindExecutable(config.ImgBurnPathOverride);
        }

        if (exe is null && imgBurnFallbackExe is null)
        {
            redumperResult = new RedumperService.DumpResult
            {
                ErrorMessage = folderPrefix == "DVD_RawISO"
                    ? "Neither redumper.exe nor ImgBurn.exe were found -- checked Settings overrides, PATH, and standard install locations for both."
                    : "redumper.exe not found -- checked Settings override, PATH, and C:\\redumper\\redumper.exe."
            };
            AddLog(redumperResult.ErrorMessage!);
            StateHasChanged();
            return;
        }

        var outputBase = GetOutputBaseFolder(config);
        var preflight = PreflightService.Check(MediaPresent, outputBase, null, AddLog, unattended: config.UnattendedAutoStart);
        if (!preflight.Ok)
        {
            preflightBlockedReason = preflight.BlockedReason;
            StateHasChanged();
            return;
        }

        var categoryDir = Path.Combine(outputBase, CategoryFolder(config, category));

        // Ported from the Python app's _start_game_pipeline(): game
        // dumps go into Games\<system folder>, named after the bay's
        // custom label when one is set (e.g. "PS3"), else General_Games.
        // (Python's middle fallback -- the disc's detected system name --
        // isn't available here, since this app doesn't extract one.)
        if (config.AutoCategorize && folderPrefix == "Game")
        {
            var sysFolder = !string.IsNullOrWhiteSpace(customLabel)
                ? FileNamingService.SanitizeFilename(customLabel)
                : "General_Games";
            categoryDir = Path.Combine(categoryDir, sysFolder);
        }

        if (folderPrefix == "DVD_RawISO" && (config.AutoCategorize || config.UnattendedAutoStart))
        {
            categoryDir = Path.Combine(categoryDir, SizeSubfolder(isBd: false));
            AddLog($"Destination: {categoryDir}");
        }
        var fallbackName = $"{folderPrefix}_{DriveLetter}_{DateTime.Now:yyyyMMdd_HHmmssfff}";
        var isoName = FileNamingService.BuildOutputName(VolumeTitle, fallbackName);

        if (config.UnattendedAutoStart)
        {
            isoName = UniqueUnattendedName(categoryDir, isoName);
        }
        else if (!FileNamingService.CheckDuplicateOrConfirm(categoryDir, isoName, false, AddLog))
        {
            preflightBlockedReason = "Cancelled due to duplicate output";
            StateHasChanged();
            return;
        }

        var outputFolder = Path.Combine(categoryDir, isoName);

        isRunning = true;
        progressPercent = 0;
        StateHasChanged();

        if (exe is not null)
        {
            runningKind = "redumper";
            runningLabel = "Redumper dumping raw sectors…";
            AddLog($"{operationLabel}: dump started (Redumper)");
            StateHasChanged();

            redumperResult = await Task.Run(() => RedumperService.RunDump(
                exe, DriveLetter, outputFolder, isoName,
                onProgress: pct => InvokeAsync(() => { progressPercent = pct; StateHasChanged(); }),
                onProcessStarted: p => currentProcess = p));
        }
        else
        {
            runningKind = "imgburn";
            runningLabel = "Reading DVD via ImgBurn (fallback -- no live progress or Cancel support for this step)…";
            progressPercent = null;
            AddLog($"{operationLabel}: dump started (ImgBurn fallback)");
            StateHasChanged();

            var imgResult = await Task.Run(() => ImgBurnService.ReadDiscToIso(imgBurnFallbackExe!, DriveLetter, outputFolder, isoName));
            redumperResult = new RedumperService.DumpResult
            {
                Success = imgResult.Success,
                IsoPath = imgResult.IsoPath,
                ErrorMessage = imgResult.ErrorMessage,
            };
        }

        isRunning = false;

        if (wasCancelled)
        {
            AddLog($"{operationLabel}: cancelled, cleaning up");
            await CleanUpCancelledFolder(outputFolder);
        }
        else
        {
            AddLog(redumperResult.Success ? $"{operationLabel}: complete -- {redumperResult.IsoPath}" : $"{operationLabel}: failed -- {redumperResult.ErrorMessage}");

            if (redumperResult.Success && redumperResult.IsoPath is not null)
            {
                lastOutputFolder = redumperResult.IsoPath;
                await VerifyOutput(redumperResult.IsoPath);
            }

            NotifyIfEnabled(config, redumperResult.Success, operationLabel, redumperResult.Success ? redumperResult.IsoPath : redumperResult.ErrorMessage);
            RecordHistory(operationLabel, redumperResult.Success ? (redumperResult.IsoPath ?? "") : "", lastSha1, lastMd5, lastRedumpMatch);
            if (redumperResult.Success)
            {
                OnRipSucceeded(config);
                AutoEjectIfEnabled(config, DriveLetter);
            }
        }

        lastAction = () => RunRedumperDump(folderPrefix, operationLabel, category);
        StateHasChanged();
    }

    private async Task RunFullBackup()
    {
        showModeDialog = false;
        var kind = dialogKind;
        ResetResultState();
        selectedMode = kind == "bd"
            ? "Blu-ray / 4K UHD (Full Backup)"
            : "DVD Movie Disc (MakeMKV Decrypted Backup)";
        var opLabel = kind == "bd" ? "Blu-ray Full Backup" : "DVD MakeMKV Backup";
        runningKind = "makemkv";
        isResolving = true;
        AddLog($"{opLabel}: resolving MakeMKV disc index");
        StateHasChanged();

        var config = ConfigService.Load();
        var exe = MakeMkvService.FindExecutable(config.MakeMkvPathOverride);
        if (exe is null)
        {
            makeMkvResult = new MakeMkvService.DiscIndexResult
            {
                ErrorMessage = "makemkvcon.exe not found -- checked Settings override, PATH, and standard install locations."
            };
            AddLog(makeMkvResult.ErrorMessage!);
            isResolving = false;
            StateHasChanged();
            return;
        }

        var outputBase = GetOutputBaseFolder(config);
        var preflight = PreflightService.Check(MediaPresent, outputBase, exe, AddLog, unattended: config.UnattendedAutoStart);
        if (!preflight.Ok)
        {
            preflightBlockedReason = preflight.BlockedReason;
            isResolving = false;
            StateHasChanged();
            return;
        }

        var imgBurnExe = kind == "bd" ? ImgBurnService.FindExecutable(config.ImgBurnPathOverride) : null;
        if (kind == "bd")
            AddLog(imgBurnExe is not null
                ? "Blu-ray Full Backup: ImgBurn found -- will build a single-file ISO as stage 2/2 after decrypt"
                : "Blu-ray Full Backup: ImgBurn not configured -- the decrypted folder will be the final output");

        var indexResult = await Task.Run(() => MakeMkvService.ResolveDiscIndex(exe, DriveLetter));
        makeMkvResult = indexResult;
        isResolving = false;
        AddLog(indexResult.Success ? $"{opLabel}: disc index {indexResult.DiscIndex}" : $"{opLabel}: {indexResult.ErrorMessage}");
        StateHasChanged();

        if (!indexResult.Success) return;

        long capacity = 0;
        try { capacity = new DriveInfo(DriveLetter).TotalSize; }
        catch { /* leave at 0 -- progress bar falls back to "size unknown" */ }

        var folderTag = kind == "bd" ? "FullBackup" : "DVD_MakeMkvBackup";
        var category = kind == "bd" ? "BluRay_Movies" : "DVD_Movies";
        var categoryDir = Path.Combine(outputBase, CategoryFolder(config, category));
        if (config.AutoCategorize || config.UnattendedAutoStart)
        {
            categoryDir = Path.Combine(categoryDir, SizeSubfolder(isBd: kind == "bd"));
            AddLog($"Destination: {categoryDir}");
        }
        var fallbackName = $"{DriveLetter}_{folderTag}_{DateTime.Now:yyyyMMdd_HHmmssfff}";
        var baseName = FileNamingService.BuildOutputName(VolumeTitle, fallbackName);

        if (config.UnattendedAutoStart)
        {
            baseName = UniqueUnattendedName(categoryDir, baseName);
        }
        else if (!FileNamingService.CheckDuplicateOrConfirm(categoryDir, baseName, false, AddLog))
        {
            preflightBlockedReason = "Cancelled due to duplicate output";
            StateHasChanged();
            return;
        }

        var outputFolder = Path.Combine(categoryDir, baseName);

        var destinationOverride = kind == "dvd"
            ? Path.Combine(outputFolder, $"{baseName}.iso")
            : null;

        var decryptTarget = (kind == "bd" && imgBurnExe is not null)
            ? Path.Combine(outputFolder, "_temp_decrypt")
            : outputFolder;

        runningLabel = kind == "bd"
            ? $"Backing up (disc index {indexResult.DiscIndex})… this may take a while"
            : $"MakeMKV decrypted backup (disc index {indexResult.DiscIndex})… this may take a while";
        isRunning = true;
        StartProgressTimer(decryptTarget, capacity);
        StateHasChanged();

        backupResult = await Task.Run(() =>
            MakeMkvService.RunBackup(exe, indexResult.DiscIndex!, decryptTarget, destinationOverride, p => currentProcess = p));
        NoteLibreDrive(backupResult.LibreDriveLine);

        StopProgressTimer();
        isRunning = false;

        if (wasCancelled)
        {
            AddLog($"{opLabel}: cancelled, cleaning up");
            await CleanUpCancelledFolder(decryptTarget);
        }
        else if (kind == "bd" && backupResult.Success && imgBurnExe is not null)
        {
            AddLog("Blu-ray Full Backup: MakeMKV decrypt complete, starting ImgBurn stage 2/2 (build single ISO)");
            runningLabel = "Building single-file ISO via ImgBurn (stage 2/2, no live progress)…";
            runningKind = "imgburn";
            isRunning = true;
            progressPercent = null;
            StateHasChanged();

            var imgBurnResult = await Task.Run(() => ImgBurnService.BuildSingleIso(imgBurnExe, decryptTarget, outputFolder, baseName));
            isRunning = false;

            if (imgBurnResult.Success)
            {
                AddLog($"ImgBurn complete: {imgBurnResult.IsoPath}");
                try { Directory.Delete(decryptTarget, recursive: true); } catch { /* best-effort cleanup */ }
                lastOutputFolder = imgBurnResult.IsoPath;
                await VerifyOutput(imgBurnResult.IsoPath!);
                NotifyIfEnabled(config, true, opLabel, imgBurnResult.IsoPath);
                RecordHistory(opLabel, imgBurnResult.IsoPath!, lastSha1, lastMd5, lastRedumpMatch);
                OnRipSucceeded(config);
                AutoEjectIfEnabled(config, DriveLetter);
            }
            else
            {
                AddLog($"[WARNING] ImgBurn did not produce a valid ISO: {imgBurnResult.ErrorMessage} -- keeping the decrypted folder instead.");
                trimMessage = "⚠ ImgBurn step failed -- decrypted folder kept as final output";
                lastOutputFolder = decryptTarget;
                NotifyIfEnabled(config, false, opLabel, "ImgBurn step failed, folder kept");
                RecordHistory(opLabel, decryptTarget);
            }
        }
        else
        {
            AddLog(backupResult.Success ? $"{opLabel}: complete -- {backupResult.OutputFolder}" : $"{opLabel}: failed -- {backupResult.ErrorMessage}");
            if (backupResult.Success) lastOutputFolder = backupResult.OutputFolder;
            NotifyIfEnabled(config, backupResult.Success, opLabel,
                backupResult.Success ? backupResult.OutputFolder : backupResult.ErrorMessage);
            RecordHistory(opLabel, backupResult.Success ? (backupResult.OutputFolder ?? "") : "");
            if (backupResult.Success)
            {
                OnRipSucceeded(config);
                AutoEjectIfEnabled(config, DriveLetter);
            }
        }

        lastAction = RunFullBackup;
        StateHasChanged();
    }

    private async Task PickMovieOnly()
    {
        showModeDialog = false;
        var kind = dialogKind;
        var kindForFolder = kind == "bd" ? "BD_MovieOnly" : "DVD_MovieOnly";
        var category = kind == "bd" ? "BluRay_Movies" : "DVD_Movies";
        ResetResultState();
        selectedMode = (kind == "bd" ? "Blu-ray / 4K UHD" : "DVD Movie Disc") + " (Movie-Only)";
        runningKind = "makemkv";
        isResolving = true;
        AddLog("Movie-Only: resolving MakeMKV disc index");
        StateHasChanged();

        var config = ConfigService.Load();
        var exe = MakeMkvService.FindExecutable(config.MakeMkvPathOverride);
        if (exe is null)
        {
            makeMkvResult = new MakeMkvService.DiscIndexResult
            {
                ErrorMessage = "makemkvcon.exe not found -- checked Settings override, PATH, and standard install locations."
            };
            AddLog(makeMkvResult.ErrorMessage!);
            isResolving = false;
            StateHasChanged();
            return;
        }

        var outputBase = GetOutputBaseFolder(config);
        var preflight = PreflightService.Check(MediaPresent, outputBase, exe, AddLog, unattended: config.UnattendedAutoStart);
        if (!preflight.Ok)
        {
            preflightBlockedReason = preflight.BlockedReason;
            isResolving = false;
            StateHasChanged();
            return;
        }

        var indexResult = await Task.Run(() => MakeMkvService.ResolveDiscIndex(exe, DriveLetter));
        makeMkvResult = indexResult;
        isResolving = false;
        AddLog(indexResult.Success ? $"Movie-Only: disc index {indexResult.DiscIndex}" : $"Movie-Only: {indexResult.ErrorMessage}");
        StateHasChanged();

        if (!indexResult.Success) return;

        runningLabel = "Scanning disc titles…";
        isRunning = true;
        AddLog("Movie-Only: scanning titles");
        StateHasChanged();

        var titles = await Task.Run(() => MakeMkvService.ScanTitles(exe, indexResult.DiscIndex!));

        isRunning = false;
        StateHasChanged();

        if (titles.Count == 0)
        {
            movieOnlyResult = new MakeMkvService.ExtractResult { ErrorMessage = "MakeMKV found no titles on this disc." };
            AddLog("Movie-Only: no titles found");
            NotifyIfEnabled(config, false, "Movie-Only extraction", "no titles found on disc");
            RecordHistory("Movie-Only extraction", "");
            lastAction = PickMovieOnly;
            StateHasChanged();
            return;
        }

        AddLog($"Movie-Only: {titles.Count} title(s) found, waiting for selection");

        var titlePicker = new TitlePickerWindow(titles) { Owner = System.Windows.Application.Current.MainWindow };
        titlePicker.Show();
        var movie = await titlePicker.ResultTask;

        if (movie is null)
        {
            AddLog("Movie-Only: cancelled at title selection");
            selectedMode = null;
            StateHasChanged();
            return;
        }

        selectedTitleSeconds = movie.Seconds;
        AddLog($"Movie-Only: selected \"{movie.Name}\" ({FormatDuration(movie.Seconds)}), {movie.Tracks.Count} track(s) found");

        var scannedAudio = movie.Tracks.Where(t => t.Type == "Audio").ToList();
        var scannedSub = movie.Tracks.Where(t => t.Type == "Subtitles").ToList();

        // Movie-Only MKVs get their own "MKV" folder (e.g.
        // BluRay_Movies\MKV\Movie Name\) so they don't mix with full
        // backups, and a full backup and an MKV of the same movie can
        // sit side by side without tripping the duplicate check. Not
        // size-sorted: BD-50 describes the disc, not the MKV file.
        var categoryDir = Path.Combine(outputBase, CategoryFolder(config, category));
        if (config.AutoCategorize)
            categoryDir = Path.Combine(categoryDir, "MKV");
        var fallbackName = $"{DriveLetter}_{kindForFolder}_{DateTime.Now:yyyyMMdd_HHmmssfff}";
        var suggestedName = FileNamingService.BuildOutputName(VolumeTitle, fallbackName);

        HashSet<string> chosenAudioIds;
        HashSet<string> chosenSubIds;
        string baseName;

        if (scannedAudio.Count == 0 && scannedSub.Count == 0)
        {
            AddLog("Movie-Only: no per-track data available, using MakeMKV's default track selection");
            chosenAudioIds = new HashSet<string>();
            chosenSubIds = new HashSet<string>();
            baseName = suggestedName;
        }
        else
        {
            var trackPicker = new TrackPickerWindow(movie.Tracks, suggestedName) { Owner = System.Windows.Application.Current.MainWindow };
            trackPicker.Show();
            var trackSelection = await trackPicker.ResultTask;

            if (trackSelection is null)
            {
                AddLog("Movie-Only: cancelled at track selection");
                selectedMode = null;
                StateHasChanged();
                return;
            }

            chosenAudioIds = trackSelection.ChosenAudioIds;
            chosenSubIds = trackSelection.ChosenSubIds;
            baseName = string.IsNullOrWhiteSpace(trackSelection.ChosenOutputName) ? suggestedName : trackSelection.ChosenOutputName;
            AddLog($"Movie-Only: keeping {chosenAudioIds.Count}/{scannedAudio.Count} audio, {chosenSubIds.Count}/{scannedSub.Count} subtitle track(s), output name \"{baseName}\"");
        }

        if (config.UnattendedAutoStart)
        {
            baseName = UniqueUnattendedName(categoryDir, baseName);
        }
        else if (!FileNamingService.CheckDuplicateOrConfirm(categoryDir, baseName, false, AddLog))
        {
            preflightBlockedReason = "Cancelled due to duplicate output";
            StateHasChanged();
            return;
        }

        var outputFolder = Path.Combine(categoryDir, baseName);

        runningLabel = $"Extracting movie-only (disc index {indexResult.DiscIndex})… this may take a while";
        isRunning = true;
        StartProgressTimer(outputFolder, movie.SizeBytes);
        StateHasChanged();

        movieOnlyResult = await Task.Run(() =>
            MakeMkvService.ExtractTitle(exe, indexResult.DiscIndex!, movie.Index, outputFolder, p => currentProcess = p));
        NoteLibreDrive(movieOnlyResult.LibreDriveLine);

        StopProgressTimer();
        isRunning = false;

        if (wasCancelled)
        {
            AddLog("Movie-Only: cancelled, cleaning up");
            await CleanUpCancelledFolder(outputFolder);
        }
        else
        {
            AddLog(movieOnlyResult.Success ? $"Movie-Only: complete -- {movieOnlyResult.OutputFolder}" : $"Movie-Only: failed -- {movieOnlyResult.ErrorMessage}");

            string? finalMkvPath = null;
            if (movieOnlyResult.Success)
            {
                lastOutputFolder = movieOnlyResult.OutputFolder;
                var renamed = MakeMkvService.RenameNewestMkv(outputFolder, baseName, AddLog);
                finalMkvPath = renamed ?? Directory.GetFiles(outputFolder, "*.mkv").FirstOrDefault();
                if (renamed is not null)
                {
                    AddLog($"Renamed to: {renamed}");
                    lastOutputFolder = renamed;
                }
            }

            bool wantsTrim = movieOnlyResult.Success &&
                (chosenAudioIds.Count < scannedAudio.Count || chosenSubIds.Count < scannedSub.Count) &&
                (scannedAudio.Count > 0 || scannedSub.Count > 0);

            if (wantsTrim && finalMkvPath is not null)
            {
                var mkvmergeExe = MkvmergeService.FindExecutable(config.MkvmergePathOverride);
                if (mkvmergeExe is null)
                {
                    AddLog("[WARNING] Exact track selection was requested but mkvmerge isn't configured in Settings -- keeping MakeMKV's full extraction instead.");
                    trimMessage = "ℹ mkvmerge not configured (see Settings) -- kept all tracks";
                }
                else
                {
                    var trimResult = await Task.Run(() => MkvmergeService.TrimTracks(
                        mkvmergeExe, finalMkvPath, scannedAudio, scannedSub, chosenAudioIds, chosenSubIds,
                        log: msg => AddLog(msg)));
                    trimMessage = trimResult.Trimmed
                        ? $"✓ {trimResult.Message}"
                        : $"ℹ {trimResult.Message}";
                }
                StateHasChanged();
            }
            else if (wantsTrim && finalMkvPath is null)
            {
                AddLog("[WARNING] Could not find the extracted .mkv file to trim.");
                trimMessage = "⚠ Extraction succeeded but the file couldn't be found for trimming.";
            }

            if (movieOnlyResult.Success && finalMkvPath is not null)
            {
                await VerifyMovieOnlyOutput(finalMkvPath);
            }

            NotifyIfEnabled(config, movieOnlyResult.Success, "Movie-Only extraction",
                movieOnlyResult.Success ? movieOnlyResult.OutputFolder : movieOnlyResult.ErrorMessage);
            RecordHistory("Movie-Only extraction", movieOnlyResult.Success ? (finalMkvPath ?? movieOnlyResult.OutputFolder ?? "") : "", lastSha1, lastMd5, lastRedumpMatch);
            if (movieOnlyResult.Success)
            {
                OnRipSucceeded(config);
                AutoEjectIfEnabled(config, DriveLetter);
            }
        }

        lastAction = PickMovieOnly;
        StateHasChanged();
    }

    private static async Task CleanUpCancelledFolder(string folder)
    {
        await Task.Delay(500);
        try { Directory.Delete(folder, recursive: true); }
        catch { /* best-effort */ }
    }

    private static string FormatDuration(int totalSeconds)
    {
        var span = TimeSpan.FromSeconds(totalSeconds);
        return span.Hours > 0 ? $"{span.Hours}h {span.Minutes}m" : $"{span.Minutes}m {span.Seconds}s";
    }

    private static string FormatGb(long bytes) => $"{bytes / (1024.0 * 1024 * 1024):F2} GB";

    protected override void OnParametersSet()
    {
        if (previousMediaPresent && !MediaPresent)
        {
            ResetResultState();
            lastAction = null;
            cachedArt = null;
            coverDataUri = null;
            showMetadataDetails = false;
            BatchSyncService.RemoveQueued(DriveLetter);
        }
        else if (!previousMediaPresent && MediaPresent)
        {
            trayIsOpen = false;

            if (!string.IsNullOrWhiteSpace(VolumeTitle))
            {
                cachedArt = MetadataFetchService.GetCachedArt(VolumeTitle);
                LoadCoverDataUri();

                if (!hasCachedCover && (Category == DiscCategory.BluRay || Category == DiscCategory.Dvd))
                {
                    _ = AutoFetchArtSilently();
                }

                _ = TryAutoStart();
            }
        }
        previousMediaPresent = MediaPresent;
    }

    public void Dispose()
    {
        StopProgressTimer();
        BatchSyncService.StateChanged -= OnBatchSyncStateChanged;
    }
}