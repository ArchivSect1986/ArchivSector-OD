@* Root component for the visual shell draft. Bay cards are
   generated dynamically from whatever optical drives actually exist,
   each keyed by drive letter. Each poll cycle computes real disc
   metadata for whatever's in the drive -- category, format/capacity,
   and (via DiscMetadataService) the disc's REAL title where one can
   be parsed, falling back to the raw Windows volume label otherwise.
   AACS version is also captured for Blu-ray discs when present, and
   for game discs the console and serial number (DiscMetadataService).
   Drive hardware is fetched once at startup. Settings, History, and
   the ISO Verifier are all real, separate WPF windows opened with
   Show(), not ShowDialog().

   "🤖 Unattended Mode" is a header-level toggle (not a Settings
   preference) -- the kind of thing flipped on right before leaving a
   disc-swapping session unattended, off when back. Persists to
   config.json like everything else, but lives here in the header,
   matching where the Python app puts its own equivalent. Each
   DriveBayCard reads this fresh on every disc insert to decide
   whether to auto-start a rip.

   v3.0: two tabs in the header, 💿 Drive Bays and 🎯 TargetFill
   (TargetFillPanel). Both stay mounted so neither loses its work when
   the other is showing.

   Started with --targetfill "<folder>" (the "TargetFill (ArchivSector-OD)"
   right-click menu on folders), the window is TargetFill-only: no drive
   bays, no drive watching and no startup update check, so it can't rip
   or update alongside a main window that's already open. *@

@implements IDisposable
@using System.IO

<div class="app-root" data-theme="@currentTheme">

    <header class="app-header">
        <div class="app-brand">
            <h1>ARCHIVSECTOR-OD</h1>
            <p>@(fillOnly ? "TargetFill — Disc Fill & Burn Prep" : "Optical Disc Ripping, Archival & Burn Prep")</p>
        </div>
        <div style="display: flex; align-items: center; flex-wrap: wrap; gap: 8px 0;">
            @if (!fillOnly)
            {
            <button class="shortcut-btn @(activeTab == "bays" ? "active-toggle" : "")" @onclick='() => activeTab = "bays"'>
                💿 Drive Bays
            </button>
            <button class="shortcut-btn @(activeTab == "fill" ? "active-toggle" : "")" style="margin-left: 8px; margin-right: 16px;" @onclick='() => activeTab = "fill"'>
                🎯 TargetFill
            </button>
            <button class="shortcut-btn @(config.UnattendedAutoStart ? "active-toggle" : "")" @onclick="ToggleUnattendedMode"
                    title="Auto-starts a rip on disc insert with no confirmation dialogs -- Blu-ray goes straight to Full Backup, DVD to a raw ISO dump.">
                🤖 Unattended Mode @(config.UnattendedAutoStart ? "ON" : "OFF")
            </button>
            }
            <button class="shortcut-btn" style="margin-left: 8px;" @onclick="OpenSettings">
                ⚙️ Settings
            </button>
            <button class="shortcut-btn" style="margin-left: 8px;" @onclick="ShowHistory">
                📜 History
            </button>
            <button class="shortcut-btn" style="margin-left: 8px;" @onclick="OpenIsoVerifier">
                🔍 ISO Verifier
            </button>
            @if (!fillOnly)
            {
                <button class="shortcut-btn" style="margin-left: 8px;" @onclick="CreateShortcut" disabled="@isCreatingShortcut">
                    @(isCreatingShortcut ? "Creating…" : "📌 Create Desktop Shortcut")
                </button>
            }
            @if (shortcutMessage is not null)
            {
                <span class="shortcut-message">@shortcutMessage</span>
            }
            <div class="theme-switch" style="margin-left: 16px;">
                @foreach (var theme in Themes)
                {
                    <button class="@(theme == currentTheme ? "active" : "")"
                            @onclick="() => SetTheme(theme)">
                        @Capitalize(theme)
                    </button>
                }
            </div>
        </div>
    </header>

    @* Both tabs stay mounted; the hidden one is only hidden, so running
       rips and a running TargetFill job keep going across tab switches. *@
    <div style="display: @(activeTab == "fill" ? "block" : "none");">
        <TargetFillPanel SourceRequest="@targetFillSource" RequestId="@targetFillRequestId" />
    </div>

    @if (!fillOnly)
    {
    <div style="display: @(activeTab == "bays" ? "block" : "none");">
    @if (driveStates.Count == 0)
    {
        <div class="bays-grid">
            <p style="color: var(--text-muted); padding: 20px;">
                No optical drives detected on this machine.
            </p>
        </div>
    }
    else
    {
        <div class="bays-grid">
            @foreach (var letter in driveStates.Keys.OrderBy(l => l))
            {
                var st = driveStates[letter];
                var hw = driveHardware.TryGetValue(letter, out var h) ? h : null;
                <DriveBayCard @key="letter"
                              DriveLetter="@letter"
                              MediaPresent="@st.MediaPresent"
                              StatusText="@st.StatusText"
                              Category="@st.Category"
                              VolumeTitle="@st.VolumeTitle"
                              FormatLabel="@st.FormatLabel"
                              CapacityLabel="@st.CapacityLabel"
                              AacsVersion="@st.AacsVersion"
                              GameSystem="@st.GameSystem"
                              Serial="@st.Serial"
                              DriveModel="@(hw?.Caption ?? "")"
                              DriveFirmware="@(hw?.Firmware ?? "")" />
            }
        </div>
    }
    </div>
    }

    <footer class="app-footer">
        @if (fillOnly)
        {
            <span>TargetFill window (opened from the right-click menu) — drive bays are in the main ArchivSector-OD window</span>
        }
        else
        {
            <span>Active Bays: @driveStates.Count &nbsp;•&nbsp; Discs Loaded: @LoadedCount/@driveStates.Count &nbsp;•&nbsp; Active Jobs: @BatchSyncService.ActiveCount @(BatchSyncService.QueuedCount > 0 ? $"(+{BatchSyncService.QueuedCount} queued)" : "")</span>
        }
        <span>ENGINE BUS: READY</span>
    </footer>

</div>

@code {
    private AppConfig config = new();
    private string currentTheme = "midnight";
    private readonly string[] Themes = { "midnight", "nova", "daylight" };

    private bool isCreatingShortcut = false;

    // "bays" or "fill" (TargetFill). A drive bay's "Make archival backup
    // disc" button switches to TargetFill with that rip's folder.
    private string activeTab = "bays";
    private string? targetFillSource = null;
    private int targetFillRequestId = 0;

    // Opened from the right-click menu (--targetfill "<folder>").
    private bool fillOnly = false;

    private void OnTargetFillRequested(string folder) => InvokeAsync(() =>
    {
        targetFillSource = folder;
        targetFillRequestId++;
        activeTab = "fill";
        StateHasChanged();
    });
    private string? shortcutMessage = null;

    private readonly Dictionary<string, DriveHardwareInfo> driveHardware = new();

    private class DriveState
    {
        public bool MediaPresent;
        public string StatusText = "Checking…";
        public DiscCategory Category = DiscCategory.Unknown;
        public string VolumeTitle = "";
        public string FormatLabel = "";
        public string CapacityLabel = "";
        public string AacsVersion = "";
        public string GameSystem = "";
        public string Serial = "";
    }

    private readonly Dictionary<string, DriveState> driveStates = new();
    private Timer? driveWatchTimer;

    private int LoadedCount => driveStates.Values.Count(d => d.MediaPresent);

    protected override void OnInitialized()
    {
        config = ConfigService.Load();
        currentTheme = config.Theme;

        var startFolder = TargetFillService.StartupFolder();
        if (startFolder is not null)
        {
            fillOnly = true;
            activeTab = "fill";
            targetFillSource = startFolder;
            targetFillRequestId = 1;
            try
            {
                var win = System.Windows.Application.Current?.MainWindow;
                if (win is not null) win.Title = $"ArchivSector-OD — TargetFill — {Path.GetFileName(startFolder.TrimEnd('\\', '/'))}";
            }
            catch { /* title is cosmetic */ }
            return;
        }

        BatchSyncService.StateChanged += OnBatchSyncStateChanged;
        TargetFillHandoff.Requested += OnTargetFillRequested;

        RefreshDriveList();

        driveWatchTimer = new Timer(_ => InvokeAsync(() =>
        {
            RefreshDriveList();
            StateHasChanged();
        }), null, TimeSpan.Zero, TimeSpan.FromSeconds(2));

        _ = Task.Run(() =>
        {
            var hw = DriveHardwareService.GetAllDriveModelsAndFirmware();
            InvokeAsync(() =>
            {
                foreach (var kv in hw) driveHardware[kv.Key] = kv.Value;
                StateHasChanged();
            });
        });
    }

    private void OnBatchSyncStateChanged() => InvokeAsync(StateHasChanged);

    // Startup update check: a few seconds after the window appears, ask
    // GitHub for a newer release and offer to install it. Silent when
    // up to date or offline. Turned off in Settings with "Check for
    // updates when the app starts".
    private bool startupUpdateCheckDone = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || startupUpdateCheckDone) return;
        startupUpdateCheckDone = true;
        if (fillOnly) return;

        if (!ConfigService.Load().CheckForUpdatesOnStartup) return;

        await Task.Delay(TimeSpan.FromSeconds(4));
        var result = await UpdateCheckService.CheckAsync();
        if (result.Status != UpdateCheckService.UpdateStatus.UpdateAvailable) return;

        await InvokeAsync(() => UpdateInstallService.OfferAndRunAsync(result, System.Windows.Application.Current.MainWindow));
    }

    // Reload before saving, so changes the drive bays saved in the
    // meantime (bay labels, OmniDrive confirmations) aren't overwritten.
    private void ToggleUnattendedMode()
    {
        var fresh = ConfigService.Load();
        fresh.UnattendedAutoStart = !config.UnattendedAutoStart;
        ConfigService.Save(fresh);
        config = fresh;
    }

    private void OpenSettings()
    {
        config = ConfigService.Load();
        var window = new SettingsWindow(config)
        {
            Owner = System.Windows.Application.Current.MainWindow
        };
        window.Show();
    }

    private void ShowHistory()
    {
        var window = new HistoryWindow
        {
            Owner = System.Windows.Application.Current.MainWindow
        };
        window.Show();
    }

    private void OpenIsoVerifier()
    {
        var window = new IsoVerifierWindow
        {
            Owner = System.Windows.Application.Current.MainWindow
        };
        window.Show();
    }

    private async Task CreateShortcut()
    {
        isCreatingShortcut = true;
        shortcutMessage = null;
        StateHasChanged();

        var result = await Task.Run(() => ShortcutService.CreateDesktopShortcut());

        isCreatingShortcut = false;
        shortcutMessage = result.Success ? $"Created: {result.Path}" : result.ErrorMessage;
        StateHasChanged();
    }

    private void RefreshDriveList()
    {
        var optical = DriveInfo.GetDrives()
            .Where(d => d.DriveType == DriveType.CDRom)
            .ToList();

        var currentLetters = optical.Select(d => LetterOf(d)).ToHashSet();

        foreach (var stale in driveStates.Keys.Except(currentLetters).ToList())
            driveStates.Remove(stale);

        foreach (var di in optical)
        {
            var letter = LetterOf(di);
            if (!driveStates.TryGetValue(letter, out var state))
            {
                state = new DriveState();
                driveStates[letter] = state;
            }
            UpdateState(di, letter, state);
        }
    }

    private static string LetterOf(DriveInfo di) => di.Name.TrimEnd('\\', ':');

    private static void UpdateState(DriveInfo di, string letter, DriveState state)
    {
        try
        {
            state.MediaPresent = di.IsReady;
            if (di.IsReady)
            {
                state.VolumeTitle = SafeVolumeLabel(di);
                state.StatusText = $"DISC PRESENT — {state.VolumeTitle}";
                state.Category = DiscDetectionService.DetectDiscCategory(letter);

                try
                {
                    var root = $"{letter}:\\";
                    var realTitle = DiscMetadataService.GetRealTitle(root, state.Category);
                    if (!string.IsNullOrWhiteSpace(realTitle.Title))
                    {
                        state.VolumeTitle = realTitle.Title;
                        state.StatusText = $"DISC PRESENT — {realTitle.Title}";
                    }
                    state.AacsVersion = realTitle.AacsVersion ?? "";
                    state.GameSystem = realTitle.GameSystem ?? "";
                    state.Serial = realTitle.Serial ?? "";
                }
                catch
                {
                    state.AacsVersion = "";
                    state.GameSystem = "";
                    state.Serial = "";
                }

                try
                {
                    state.CapacityLabel = $"{di.TotalSize / Math.Pow(1024, 3):F2} GB";
                    state.FormatLabel = DiscDetectionService.ClassifyCapacity(di.TotalSize);
                }
                catch
                {
                    state.CapacityLabel = "";
                    state.FormatLabel = "";
                }
            }
            else
            {
                state.StatusText = "STANDBY // MEDIA ABSENT";
                state.Category = DiscCategory.Unknown;
                state.VolumeTitle = "";
                state.FormatLabel = "";
                state.CapacityLabel = "";
                state.AacsVersion = "";
                state.GameSystem = "";
                state.Serial = "";
            }
        }
        catch (Exception ex)
        {
            state.StatusText = $"ERROR: {ex.Message}";
            state.MediaPresent = false;
            state.Category = DiscCategory.Unknown;
        }
    }

    private static string SafeVolumeLabel(DriveInfo di)
    {
        try { return string.IsNullOrWhiteSpace(di.VolumeLabel) ? "UNLABELED" : di.VolumeLabel; }
        catch { return "UNLABELED"; }
    }

    private void SetTheme(string theme)
    {
        currentTheme = theme;
        var fresh = ConfigService.Load();
        fresh.Theme = theme;
        ConfigService.Save(fresh);
        config = fresh;
    }

    private static string Capitalize(string s) =>
        string.IsNullOrEmpty(s) ? s : char.ToUpper(s[0]) + s.Substring(1);

    public void Dispose()
    {
        driveWatchTimer?.Dispose();
        BatchSyncService.StateChanged -= OnBatchSyncStateChanged;
        TargetFillHandoff.Requested -= OnTargetFillRequested;
    }
}