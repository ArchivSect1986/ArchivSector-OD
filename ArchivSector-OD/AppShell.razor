@* Root component for the visual shell draft. Bay cards are
   generated dynamically from whatever optical drives actually exist,
   each keyed by drive letter. Each poll cycle computes real disc
   metadata for whatever's in the drive -- category, format/capacity,
   and (via DiscMetadataService) the disc's REAL title where one can
   be parsed, falling back to the raw Windows volume label otherwise.
   AACS version is also captured for Blu-ray discs when present, and
   for game discs the console and serial number (DiscMetadataService).
   Drive hardware is fetched once at startup. Settings, History, and
   the ISO Verifier are all real, separate WPF windows opened with
   Show(), not ShowDialog().

   "🤖 Unattended Mode" is a header-level toggle (not a Settings
   preference) -- the kind of thing flipped on right before leaving a
   disc-swapping session unattended, off when back. Persists to
   config.json like everything else, but lives here in the header,
   matching where the Python app puts its own equivalent. Each
   DriveBayCard reads this fresh on every disc insert to decide
   whether to auto-start a rip.

   v4.0: the header was tidied -- the tabs are one switcher, History,
   ISO Verifier, Theme and Settings are small icon buttons, the theme
   buttons became one 🎨 menu, and Create Desktop Shortcut lives only in
   Settings (it was in both places).

   v3.0: two tabs in the header, 💿 Drive Bays and 🎯 TargetFill
   (TargetFillPanel). Both stay mounted so neither loses its work when
   the other is showing.

   Started with --targetfill "<folder>" (the "TargetFill (ArchivSector-OD)"
   right-click menu on folders), the window is TargetFill-only: no drive
   bays, no drive watching and no startup update check, so it can't rip
   or update alongside a main window that's already open. *@

@implements IDisposable
@using System.IO

<div class="app-root" data-theme="@currentTheme">

    <header class="app-header">
        <div class="app-brand">
            <h1>ARCHIVSECTOR-OD</h1>
            <p>@(fillOnly ? "TargetFill — Disc Fill & Burn Prep" : "Optical Disc Ripping, Archival & Burn Prep")</p>
        </div>

        @if (!fillOnly)
        {
            <nav class="app-nav" aria-label="Main">
                <button class="nav-btn @(activeTab == "bays" ? "active" : "")" @onclick='() => activeTab = "bays"'>💿 Drive Bays</button>
                <button class="nav-btn @(activeTab == "burn" ? "active" : "")" @onclick='() => activeTab = "burn"'>🔥 Burn</button>
                <button class="nav-btn @(activeTab == "fill" ? "active" : "")" @onclick='() => activeTab = "fill"'>🎯 TargetFill</button>
            </nav>
        }

        <div class="header-actions">
            @if (shortcutMessage is not null)
            {
                <span class="shortcut-message">@shortcutMessage</span>
            }
            @if (!fillOnly)
            {
                <button class="unattended-pill @(config.UnattendedAutoStart ? "on" : "")" @onclick="ToggleUnattendedMode"
                        title="Auto-starts a rip on disc insert with no confirmation dialogs -- Blu-ray goes straight to Full Backup, DVD to a raw ISO dump.">
                    <span class="dot"></span>Unattended @(config.UnattendedAutoStart ? "on" : "off")
                </button>
            }
            <button class="icon-btn" @onclick="ShowHistory" title="History" aria-label="History">📜</button>
            <button class="icon-btn" @onclick="OpenIsoVerifier" title="ISO Verifier" aria-label="ISO Verifier">🔍</button>
            <button class="icon-btn @(themeMenuOpen ? "open" : "")" @onclick="() => themeMenuOpen = !themeMenuOpen" title="Theme" aria-label="Theme" aria-expanded="@(themeMenuOpen ? "true" : "false")">🎨</button>
            <button class="icon-btn" @onclick="OpenSettings" title="Settings (also has Create Desktop Shortcut)" aria-label="Settings">⚙️</button>

            @if (themeMenuOpen)
            {
                <div class="menu-backdrop" @onclick="() => themeMenuOpen = false"></div>
                <div class="theme-menu" role="dialog" aria-label="Choose a theme">
                    <h3>Theme</h3>
                    <div class="theme-grid">
                        @foreach (var t in Themes)
                        {
                            <button class="theme-tile @(t.Id == currentTheme ? "active" : "")" @onclick="() => PickTheme(t.Id)">
                                <span class="theme-preview" style="background: @t.Background; border: 1px solid @t.Panel;">
                                    <span style="width: 40%; background: @t.Accent;"></span>
                                    <span style="width: 25%; background: @t.Panel;"></span>
                                    <span style="width: 15%; background: @t.Text;"></span>
                                </span>
                                @t.Name
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </header>

    @* Both tabs stay mounted; the hidden one is only hidden, so running
       rips and a running TargetFill job keep going across tab switches. *@
    <div style="display: @(activeTab == "fill" ? "block" : "none");">
        <TargetFillPanel SourceRequest="@targetFillSource" RequestId="@targetFillRequestId" />
    </div>

    @if (!fillOnly)
    {
    @* Burn tab (in progress). It only scans the drives once it's first shown. *@
    <div style="display: @(activeTab == "burn" ? "block" : "none");">
        <BurnTab Visible="@(activeTab == "burn")" />
    </div>

    <div style="display: @(activeTab == "bays" ? "block" : "none");">
    @if (driveStates.Count == 0)
    {
        <div class="bays-grid">
            <p style="color: var(--text-muted); padding: 20px;">
                No optical drives detected on this machine.
            </p>
        </div>
    }
    else
    {
        <div class="bays-grid">
            @foreach (var letter in driveStates.Keys.OrderBy(l => l))
            {
                var st = driveStates[letter];
                var hw = driveHardware.TryGetValue(letter, out var h) ? h : null;
                <DriveBayCard @key="letter"
                              DriveLetter="@letter"
                              MediaPresent="@st.MediaPresent"
                              StatusText="@st.StatusText"
                              Category="@st.Category"
                              VolumeTitle="@st.VolumeTitle"
                              FormatLabel="@st.FormatLabel"
                              CapacityLabel="@st.CapacityLabel"
                              AacsVersion="@st.AacsVersion"
                              GameSystem="@st.GameSystem"
                              Serial="@st.Serial"
                              BlankMediaType="@st.BlankMediaType"
                              BlankFreeBytes="@st.BlankFreeBytes" BlankTotalBytes="@st.BlankTotalBytes"
                              DriveModel="@(hw?.Caption ?? "")"
                              DriveFirmware="@(hw?.Firmware ?? "")" />
            }
        </div>
    }
    </div>
    }

    <footer class="app-footer">
        @if (fillOnly)
        {
            <span>TargetFill window (opened from the right-click menu) — drive bays are in the main ArchivSector-OD window</span>
        }
        else
        {
            <span>Active Bays: @driveStates.Count &nbsp;•&nbsp; Discs Loaded: @LoadedCount/@driveStates.Count &nbsp;•&nbsp; Active Jobs: @BatchSyncService.ActiveCount @(BatchSyncService.QueuedCount > 0 ? $"(+{BatchSyncService.QueuedCount} queued)" : "")</span>
        }
        <span>ENGINE BUS: READY</span>
    </footer>

</div>

@code {
    private AppConfig config = new();
    private string currentTheme = "midnight";
    // The themes offered in the 🎨 menu. Each Id matches a [data-theme="…"]
    // block in app.css; the colours here only draw the little preview tile.
    private sealed record ThemeInfo(string Id, string Name, string Background, string Panel, string Accent, string Text);
    private static readonly ThemeInfo[] Themes =
    {
        new("midnight", "Midnight", "#0b1120", "#2a3550", "#22d3ee", "#e5e9f5"),
        new("nova",     "Nova",     "#070d1a", "#243255", "#2dd4bf", "#eef2fb"),
        new("daylight", "Daylight", "#d8dce6", "#b7c0d1", "#0891b2", "#141a2e"),
    };
    private bool themeMenuOpen;


    // "bays" or "fill" (TargetFill). A drive bay's "Make archival backup
    // disc" button switches to TargetFill with that rip's folder.
    private string activeTab = "bays";
    private string? targetFillSource = null;
    private int targetFillRequestId = 0;

    // Opened from the right-click menu (--targetfill "<folder>").
    private bool fillOnly = false;

    private void OnTargetFillRequested(string folder) => InvokeAsync(() =>
    {
        targetFillSource = folder;
        targetFillRequestId++;
        activeTab = "fill";
        StateHasChanged();
    });
    private string? shortcutMessage = null;

    private readonly Dictionary<string, DriveHardwareInfo> driveHardware = new();

    private class DriveState
    {
        public bool MediaPresent;
        public string StatusText = "Checking…";
        public DiscCategory Category = DiscCategory.Unknown;
        public string VolumeTitle = "";
        public string FormatLabel = "";
        public string CapacityLabel = "";
        public string AacsVersion = "";
        public string GameSystem = "";
        public string Serial = "";
        public string BlankMediaType = "";   // "BD-R" etc. when a blank, writable disc is in
        public long BlankFreeBytes;
        public long BlankTotalBytes;
    }

    private readonly Dictionary<string, DriveState> driveStates = new();
    private Timer? driveWatchTimer;

    private int LoadedCount => driveStates.Values.Count(d => d.MediaPresent);

    protected override void OnInitialized()
    {
        config = ConfigService.Load();
        currentTheme = config.Theme;

        var startFolder = TargetFillService.StartupFolder();
        if (startFolder is not null)
        {
            fillOnly = true;
            activeTab = "fill";
            targetFillSource = startFolder;
            targetFillRequestId = 1;
            try
            {
                var win = System.Windows.Application.Current?.MainWindow;
                if (win is not null) win.Title = $"ArchivSector-OD — TargetFill — {Path.GetFileName(startFolder.TrimEnd('\\', '/'))}";
            }
            catch { /* title is cosmetic */ }
            return;
        }

        BatchSyncService.StateChanged += OnBatchSyncStateChanged;
        TargetFillHandoff.Requested += OnTargetFillRequested;

        // Drives are checked on a background thread every 2 seconds. A drive
        // spinning up after its tray closes can keep Windows busy for several
        // seconds; on the window's own thread that froze the whole app.
        driveWatchTimer = new Timer(_ => _ = PollDrivesAsync(), null, TimeSpan.Zero, TimeSpan.FromSeconds(2));

        _ = Task.Run(() =>
        {
            var hw = DriveHardwareService.GetAllDriveModelsAndFirmware();
            InvokeAsync(() =>
            {
                foreach (var kv in hw) driveHardware[kv.Key] = kv.Value;
                StateHasChanged();
            });
        });
    }

    private void OnBatchSyncStateChanged() => InvokeAsync(StateHasChanged);

    // Startup update check: a few seconds after the window appears, ask
    // GitHub for a newer release and offer to install it. Silent when
    // up to date or offline. Turned off in Settings with "Check for
    // updates when the app starts".
    private bool startupUpdateCheckDone = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || startupUpdateCheckDone) return;
        startupUpdateCheckDone = true;
        if (fillOnly) return;

        await CheckShortcutsAsync();

        if (!ConfigService.Load().CheckForUpdatesOnStartup) return;

        await Task.Delay(TimeSpan.FromSeconds(4));
        var result = await UpdateCheckService.CheckAsync();
        if (result.Status != UpdateCheckService.UpdateStatus.UpdateAvailable) return;

        await InvokeAsync(() => UpdateInstallService.OfferAndRunAsync(result, System.Windows.Application.Current.MainWindow));
    }

    // v3.4: a shortcut that opens an older copy of the app (one the
    // updater never reaches) is offered to be pointed at this copy.
    // Debug builds (run from Visual Studio) only log what they'd offer, so
    // a test build never takes over the real shortcuts.
    private async Task CheckShortcutsAsync()
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(2));
            var stale = await Task.Run(ShortcutService.FindStaleShortcuts);
            if (stale.Count == 0) return;

            var lines = string.Join("\n", stale.Select(s =>
                $"• {s.Where}: {Path.GetFileNameWithoutExtension(s.LinkPath)} → " +
                (s.TargetVersion is null ? $"a copy that's no longer there ({s.Target})" : $"v{s.TargetVersion} in {Path.GetDirectoryName(s.Target)}")));
            if (ShortcutService.IsDebugBuild)
            {
                LogService.Write("App", "Shortcut check (debug build, nothing changed). Would offer to fix:\n" + lines);
                return;
            }
            var owner = System.Windows.Application.Current.MainWindow;
            var msg = (stale.Count == 1 ? "A shortcut opens" : "These shortcuts open") +
                      " an older copy of ArchivSector-OD, which doesn't get updates:\n\n" + lines +
                      $"\n\nPoint {(stale.Count == 1 ? "it" : "them")} to this copy (v{UpdateCheckService.CurrentVersionDisplay})?\n" +
                      "The older copy isn't deleted.";
            var answer = System.Windows.MessageBox.Show(owner, msg, "ArchivSector-OD — Shortcuts",
                System.Windows.MessageBoxButton.YesNo, System.Windows.MessageBoxImage.Question);
            if (answer != System.Windows.MessageBoxResult.Yes)
            {
                ShortcutService.Ignore(stale);
                LogService.Write("App", "Shortcut check: left as they are:\n" + lines);
                return;
            }
            var failed = await Task.Run(() => ShortcutService.Repoint(stale));
            LogService.Write("App", $"Shortcut check: pointed {stale.Count - failed.Count} shortcut(s) to {Environment.ProcessPath}" +
                (failed.Count > 0 ? "; couldn't change: " + string.Join(", ", failed.Select(f => f.Shortcut.LinkPath + " (" + f.Error + ")")) : ""));
            if (failed.Count > 0)
                System.Windows.MessageBox.Show(owner,
                    "These shortcuts couldn't be changed:\n\n" + string.Join("\n", failed.Select(f => $"• {f.Shortcut.LinkPath} ({f.Error})")) +
                    "\n\nYou can delete them and use \"📌 Create Desktop Shortcut\" instead.",
                    "ArchivSector-OD — Shortcuts", System.Windows.MessageBoxButton.OK, System.Windows.MessageBoxImage.Warning);
            else
            {
                shortcutMessage = stale.Count == 1 ? "Shortcut updated to this copy." : $"{stale.Count} shortcuts updated to this copy.";
                StateHasChanged();
            }
        }
        catch { /* never let this get in the way of starting up */ }
    }

    // Reload before saving, so changes the drive bays saved in the
    // meantime (bay labels, OmniDrive confirmations) aren't overwritten.
    private void ToggleUnattendedMode()
    {
        var fresh = ConfigService.Load();
        fresh.UnattendedAutoStart = !config.UnattendedAutoStart;
        ConfigService.Save(fresh);
        config = fresh;
    }

    private void OpenSettings()
    {
        config = ConfigService.Load();
        var window = new SettingsWindow(config)
        {
            Owner = System.Windows.Application.Current.MainWindow
        };
        window.Show();
    }

    private void ShowHistory()
    {
        var window = new HistoryWindow
        {
            Owner = System.Windows.Application.Current.MainWindow
        };
        window.Show();
    }

    private void OpenIsoVerifier()
    {
        var window = new IsoVerifierWindow
        {
            Owner = System.Windows.Application.Current.MainWindow
        };
        window.Show();
    }


    // ---- drive polling (background) ----

    private int pollBusy = 0;

    // What a disc looked like last time, so it's only examined again when
    // something changes (a different disc, or the tray opened/closed).
    private sealed class DiscKey
    {
        public bool Ready;
        public string Label = "";
        public long Size;
        public bool SameAs(DiscKey o) => Ready == o.Ready && Label == o.Label && Size == o.Size;
    }
    private readonly Dictionary<string, (DiscKey Key, DriveState State)> pollCache = new();
    private readonly Dictionary<string, DateTime> lastBlankCheck = new();

    private async Task PollDrivesAsync()
    {
        if (Interlocked.Exchange(ref pollBusy, 1) == 1) return;   // previous check still running
        try
        {
            var fresh = await Task.Run(ReadDrives);
            await InvokeAsync(() =>
            {
                foreach (var stale in driveStates.Keys.Except(fresh.Keys).ToList())
                    driveStates.Remove(stale);
                foreach (var (letter, st) in fresh)
                    driveStates[letter] = st;
                StateHasChanged();
            });
        }
        catch { /* a failed check is simply retried in 2 seconds */ }
        finally
        {
            Interlocked.Exchange(ref pollBusy, 0);
        }
    }

    // Runs on a background thread. Returns a new DriveState per drive
    // letter; a disc that hasn't changed reuses last time's details.
    private Dictionary<string, DriveState> ReadDrives()
    {
        var result = new Dictionary<string, DriveState>();
        var optical = DriveInfo.GetDrives().Where(d => d.DriveType == DriveType.CDRom).ToList();

        foreach (var di in optical)
        {
            var letter = LetterOf(di);

            // A drive that's burning isn't asked anything (even "is a disc
            // ready?" can stall while it writes); its last state stays shown.
            if (BurnService.IsBusy(letter) && pollCache.TryGetValue(letter, out var burning))
            {
                result[letter] = burning.State;
                continue;
            }

            var key = new DiscKey();
            try
            {
                key.Ready = di.IsReady;   // this is the call that can take seconds
                if (key.Ready)
                {
                    key.Label = SafeVolumeLabel(di);
                    try { key.Size = di.TotalSize; } catch { }
                }
            }
            catch { key.Ready = false; }

            // No readable disc: is it a blank, writable one? (Asked every 4
            // seconds at most, and never while the drive is busy -- a burn
            // in progress also looks like "no readable disc".)
            if (!key.Ready)
            {
                bool busy = BurnService.IsBusy(letter) || BurnService.IsPaused(letter) || RipActivity.IsDriveBusy(letter);
                bool recent = lastBlankCheck.TryGetValue(letter, out var lastCheck) && DateTime.Now - lastCheck < TimeSpan.FromSeconds(4);
                if (pollCache.TryGetValue(letter, out var prev) && prev.Key.SameAs(key) && (busy || recent))
                {
                    result[letter] = prev.State;
                    continue;
                }
                lastBlankCheck[letter] = DateTime.Now;
                var absent = new DriveState();
                UpdateState(di, letter, absent);
                var blank = busy ? null : BurnService.QueryBlank(letter);
                if (blank is not null)
                {
                    absent.BlankMediaType = blank.MediaType;
                    absent.BlankFreeBytes = blank.FreeBytes;
                    absent.BlankTotalBytes = blank.TotalBytes;
                    absent.StatusText = $"BLANK DISC — {blank.MediaType}, {DiscHealthService.FormatBytes(blank.FreeBytes)} free";
                }
                pollCache[letter] = (key, absent);
                result[letter] = absent;
                continue;
            }

            if (pollCache.TryGetValue(letter, out var cached) && cached.Key.SameAs(key))
            {
                result[letter] = cached.State;
                continue;
            }

            var state = new DriveState();
            UpdateState(di, letter, state);
            pollCache[letter] = (key, state);
            result[letter] = state;
        }

        foreach (var gone in pollCache.Keys.Except(result.Keys).ToList())
            pollCache.Remove(gone);
        return result;
    }

    private static string LetterOf(DriveInfo di) => di.Name.TrimEnd('\\', ':');

    private static void UpdateState(DriveInfo di, string letter, DriveState state)
    {
        try
        {
            state.MediaPresent = di.IsReady;
            if (di.IsReady)
            {
                state.VolumeTitle = SafeVolumeLabel(di);
                state.StatusText = $"DISC PRESENT — {state.VolumeTitle}";
                state.Category = DiscDetectionService.DetectDiscCategory(letter);

                try
                {
                    var root = $"{letter}:\\";
                    var realTitle = DiscMetadataService.GetRealTitle(root, state.Category);
                    if (!string.IsNullOrWhiteSpace(realTitle.Title))
                    {
                        state.VolumeTitle = realTitle.Title;
                        state.StatusText = $"DISC PRESENT — {realTitle.Title}";
                    }
                    state.AacsVersion = realTitle.AacsVersion ?? "";
                    state.GameSystem = realTitle.GameSystem ?? "";
                    state.Serial = realTitle.Serial ?? "";
                }
                catch
                {
                    state.AacsVersion = "";
                    state.GameSystem = "";
                    state.Serial = "";
                }

                try
                {
                    state.CapacityLabel = $"{di.TotalSize / Math.Pow(1024, 3):F2} GB";
                    state.FormatLabel = DiscDetectionService.ClassifyCapacity(di.TotalSize);
                }
                catch
                {
                    state.CapacityLabel = "";
                    state.FormatLabel = "";
                }
            }
            else
            {
                state.StatusText = "STANDBY // MEDIA ABSENT";
                state.Category = DiscCategory.Unknown;
                state.VolumeTitle = "";
                state.FormatLabel = "";
                state.CapacityLabel = "";
                state.AacsVersion = "";
                state.GameSystem = "";
                state.Serial = "";
            }
        }
        catch (Exception ex)
        {
            state.StatusText = $"ERROR: {ex.Message}";
            state.MediaPresent = false;
            state.Category = DiscCategory.Unknown;
        }
    }

    private static string SafeVolumeLabel(DriveInfo di)
    {
        try { return string.IsNullOrWhiteSpace(di.VolumeLabel) ? "UNLABELED" : di.VolumeLabel; }
        catch { return "UNLABELED"; }
    }

    private void SetTheme(string theme)
    {
        currentTheme = theme;
        var fresh = ConfigService.Load();
        fresh.Theme = theme;
        ConfigService.Save(fresh);
        config = fresh;
    }

    private void PickTheme(string theme)
    {
        SetTheme(theme);
        themeMenuOpen = false;
    }

    public void Dispose()
    {
        driveWatchTimer?.Dispose();
        BatchSyncService.StateChanged -= OnBatchSyncStateChanged;
        TargetFillHandoff.Requested -= OnTargetFillRequested;
    }
}