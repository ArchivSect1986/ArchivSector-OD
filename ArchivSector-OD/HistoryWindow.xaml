<Window x:Class="ArchivSector_OD.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ArchivSector-OD - History"
        Height="580" Width="1000" MinHeight="380" MinWidth="720"
        FontSize="12.5"
        WindowStartupLocation="CenterOwner">
    <!-- Colours, corners and font come from the theme (WpfTheme.Apply in the
         code), so every colour here is a {DynamicResource …} name. -->
    <Grid Margin="18,16,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="📜 History" Foreground="{DynamicResource Text}"
                       FontWeight="SemiBold" FontSize="20" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="🔍 Search Redump.org" Margin="0,0,8,0" Click="RedumpButton_Click"/>
                <Button Content="📤 Export what's shown to CSV…" Margin="0,0,8,0" Click="ExportButton_Click"/>
                <Button Content="📄 Open the CSV file" Margin="0,0,8,0" Click="OpenCsvButton_Click"/>
                <Button Content="🗑 Clear history…" Style="{DynamicResource DangerButton}" Click="ClearButton_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Edge}" BorderThickness="1"
                CornerRadius="{DynamicResource Radius}" Padding="14,10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="StatsTotalsText" Foreground="{DynamicResource Text}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="StatsBreakdownText" Foreground="{DynamicResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MaxWidth="420"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="🔎 Filter" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center" Margin="0,0,8,0"
                       ToolTip="Searches the title, system, serial, drive model and Redump match"/>
            <TextBox x:Name="FilterBox" Grid.Column="1" TextChanged="FilterBox_TextChanged"
                     ToolTip="Searches the title, system, serial, drive model and Redump match"/>
            <TextBlock x:Name="CountText" Grid.Column="2" Foreground="{DynamicResource Muted}" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </Grid>

        <DataGrid x:Name="HistoryGrid" Grid.Row="3" AutoGenerateColumns="True"
                  IsReadOnly="True" CanUserAddRows="False" Margin="0,0,0,12"/>

        <Button x:Name="CloseButton" Grid.Row="4" Content="Close" MinWidth="90"
                HorizontalAlignment="Right" Click="CloseButton_Click"/>
    </Grid>
</Window>
