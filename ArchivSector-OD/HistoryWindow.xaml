<Window x:Class="ArchivSector_OD.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Archival Session History"
        Height="560" Width="960"
        Background="#141b2d"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="📜 Archival Ripping History Record" Foreground="#e5e9f5"
                       FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="🔍 Search Redump.org" Padding="10,4" Margin="0,0,6,0" Click="RedumpButton_Click"/>
                <Button Content="Export Filtered to CSV..." Padding="10,4" Margin="0,0,6,0" Click="ExportButton_Click"/>
                <Button Content="Open CSV File" Padding="10,4" Margin="0,0,6,0" Click="OpenCsvButton_Click"/>
                <Button Content="🗑 Clear History..." Padding="10,4" Background="#ef4444" Foreground="White" Click="ClearButton_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#1b2438" BorderBrush="#2a3550" BorderThickness="1"
                CornerRadius="4" Padding="12,8" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="StatsTotalsText" Foreground="#e5e9f5" FontWeight="Bold" FontSize="11" TextWrapping="Wrap"/>
                <TextBlock x:Name="StatsBreakdownText" Foreground="#8b93a8" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Filter (title, system, drive model, or Redump match):" Foreground="#8b93a8"
                       FontSize="11" VerticalAlignment="Center"/>
            <TextBox x:Name="FilterBox" Width="280" Margin="8,0,8,0" Padding="4,2"
                     Background="#1b2438" Foreground="#e5e9f5" BorderBrush="#2a3550"
                     TextChanged="FilterBox_TextChanged"/>
            <TextBlock x:Name="CountText" Foreground="#5b6478" FontSize="11" VerticalAlignment="Center"/>
        </StackPanel>

        <DataGrid x:Name="HistoryGrid" Grid.Row="3" AutoGenerateColumns="True"
                  Background="#1b2438" Foreground="#141a2e" BorderBrush="#2a3550"
                  IsReadOnly="True" CanUserAddRows="False" Margin="0,0,0,12"/>

        <Button x:Name="CloseButton" Grid.Row="4" Content="Close" Width="90" Height="32"
                HorizontalAlignment="Right" Click="CloseButton_Click"/>
    </Grid>
</Window>