<Window x:Class="ArchivSector_OD.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System Settings &amp; Archival Preferences"
        Height="800" Width="760"
        Background="#141b2d"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>

                <!-- Version + update check + shortcut -->
                <Border Background="#1b2438" BorderBrush="#2a3550" BorderThickness="1" Padding="10,8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Version: " Foreground="#8b93a8" FontWeight="Bold" FontSize="11"/>
                                <TextBlock x:Name="VersionText" Foreground="#22d3ee" FontSize="11"/>
                            </StackPanel>
                            <TextBlock x:Name="UpdateStatusText" Foreground="#8b93a8" FontSize="10" TextWrapping="Wrap" Margin="0,3,8,0"/>
                        </StackPanel>
                        <Button x:Name="CheckUpdatesButton" Grid.Column="1" Content="Check for Updates" Padding="8,3" Margin="0,0,6,0" VerticalAlignment="Center" Click="CheckUpdatesButton_Click"/>
                        <Button Grid.Column="2" Content="Create Desktop Shortcut" Padding="8,3" VerticalAlignment="Center" Click="CreateShortcutButton_Click"/>
                    </Grid>
                </Border>

                <!-- Config folder -->
                <Border Background="#1b2438" BorderBrush="#2a3550" BorderThickness="1" Padding="10,8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Config / Cache Folder: " Foreground="#8b93a8" FontWeight="Bold" FontSize="11"/>
                            <TextBlock x:Name="ConfigDirText" Foreground="#22d3ee" FontSize="11"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Run Write Diagnostic" Background="#ef4444" Foreground="White" Padding="8,3" Margin="0,0,6,0" Click="RunDiagnosticButton_Click"/>
                        <Button Grid.Column="2" Content="Open Folder" Padding="8,3" Click="OpenFolderButton_Click"/>
                    </Grid>
                </Border>

                <!-- Redump DAT files -->
                <Border Background="#1b2438" BorderBrush="#2a3550" BorderThickness="1" Padding="10,8" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Redump Verification (DAT files):" Foreground="#8b93a8" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                        <TextBlock x:Name="DatListText" Foreground="#22d3ee" FontSize="10" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Import DAT File..." Padding="8,3" Margin="0,0,6,0" Click="ImportDatButton_Click"/>
                            <Button Content="Get DAT Files from Redump.org" Background="#22d3ee" Foreground="Black" Padding="8,3" Click="OpenRedumpSiteButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Output folder -->
                <TextBlock Text="Default Output Base Folder:" Foreground="#e5e9f5" FontWeight="Bold" FontSize="12" Margin="0,8,0,4"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="OutputFolderBox" Background="#1b2438" Foreground="#e5e9f5" BorderBrush="#2a3550" Padding="8"/>
                    <Button Grid.Column="1" Content="Browse..." Padding="8,3" Margin="6,0,0,0" Click="BrowseOutputFolderButton_Click"/>
                </Grid>

                <!-- MakeMKV -->
                <TextBlock Text="MakeMKV executable (makemkvcon64.exe):" Foreground="#e5e9f5" FontWeight="Bold" FontSize="12" Margin="0,4,0,4"/>
                <TextBox x:Name="MakeMkvPathBox" Background="#1b2438" Foreground="#e5e9f5" BorderBrush="#2a3550" Padding="8" Margin="0,0,0,8"/>

                <!-- Redumper -->
                <TextBlock Text="Redumper executable (redumper.exe):" Foreground="#e5e9f5" FontWeight="Bold" FontSize="12" Margin="0,4,0,4"/>
                <TextBox x:Name="RedumperPathBox" Background="#1b2438" Foreground="#e5e9f5" BorderBrush="#2a3550" Padding="8" Margin="0,0,0,8"/>

                <!-- ImgBurn -->
                <TextBlock Text="ImgBurn executable (optional — builds single-file Blu-ray ISOs):" Foreground="#e5e9f5" FontWeight="Bold" FontSize="12" Margin="0,4,0,4" TextWrapping="Wrap"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ImgBurnPathBox" Background="#1b2438" Foreground="#e5e9f5" BorderBrush="#2a3550" Padding="8"/>
                    <Button Grid.Column="1" Content="Browse..." Padding="8,3" Margin="6,0,0,0" Click="BrowseImgBurnButton_Click"/>
                </Grid>

                <!-- mkvmerge -->
                <TextBlock Text="mkvmerge executable (optional — MKVToolNix, exact per-track selection for Movie-Only MKV):" Foreground="#e5e9f5" FontWeight="Bold" FontSize="12" Margin="0,4,0,4" TextWrapping="Wrap"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="MkvmergePathBox" Background="#1b2438" Foreground="#e5e9f5" BorderBrush="#2a3550" Padding="8"/>
                    <Button Grid.Column="1" Content="Browse..." Padding="8,3" Margin="6,0,0,0" Click="BrowseMkvmergeButton_Click"/>
                </Grid>

                <!-- RAWG -->
                <TextBlock Text="RAWG API key (games metadata &amp; artwork — rawg.io/apidocs):" Foreground="#e5e9f5" FontWeight="Bold" FontSize="12" Margin="0,4,0,4" TextWrapping="Wrap"/>
                <PasswordBox x:Name="RawgKeyBox" Background="#1b2438" Foreground="#e5e9f5" BorderBrush="#2a3550" Padding="8" Margin="0,0,0,8"/>

                <!-- TMDB -->
                <TextBlock Text="TMDB API key (movie metadata &amp; artwork — themoviedb.org):" Foreground="#e5e9f5" FontWeight="Bold" FontSize="12" Margin="0,4,0,4" TextWrapping="Wrap"/>
                <PasswordBox x:Name="TmdbKeyBox" Background="#1b2438" Foreground="#e5e9f5" BorderBrush="#2a3550" Padding="8" Margin="0,0,0,8"/>

                <!-- Core toggles -->
                <CheckBox x:Name="AutoCategorizeCheck" Content="Auto-categorize sub-folders (\BluRay__Movies, \DVD__Movies, and \Games\)" Foreground="#e5e9f5" Margin="0,8,0,4"/>
                <CheckBox x:Name="AutoEjectCheck" Content="Auto-eject physical optical tray on completion" Foreground="#e5e9f5" Margin="0,0,0,4"/>
                <CheckBox x:Name="ToastCheck" Content="Show a Windows notification when a rip completes" Foreground="#e5e9f5" Margin="0,0,0,4"/>
                <CheckBox x:Name="SoundCheck" Content="Play a sound when a rip completes" Foreground="#e5e9f5" Margin="0,0,0,4"/>
                <CheckBox x:Name="StartupUpdateCheck" Content="Check for updates when the app starts" Foreground="#e5e9f5" Margin="0,0,0,8"/>

                <!-- Extra Features -->
                <Expander Header="Extra Features" Foreground="#f59e0b" Background="#1b2438" BorderBrush="#2a3550" BorderThickness="1" Padding="10" Margin="0,4,0,0">
                    <StackPanel Margin="4,8,4,4">
                        <CheckBox x:Name="AutoFetchArtCheck" Content="Auto-Fetch Metadata &amp; Artwork" Foreground="#e5e9f5" FontWeight="Bold" Margin="0,0,0,2"/>
                        <TextBlock Text="For movie discs on insertion (not games)." Foreground="#8b93a8" FontSize="10" Margin="18,0,0,10"/>

                        <CheckBox x:Name="BatchQueueCheck" Content="Batch Queue Mode" Foreground="#e5e9f5" FontWeight="Bold" Margin="0,0,0,2"/>
                        <TextBlock Text="Skip completion prompt; auto-continue on next disc swap." Foreground="#8b93a8" FontSize="10" TextWrapping="Wrap" Margin="18,0,0,10"/>

                        <CheckBox x:Name="MultiDriveSyncCheck" Content="Multi-Drive Batch Sync" Foreground="#e5e9f5" FontWeight="Bold" Margin="0,0,0,2"/>
                        <TextBlock Text="Caps concurrent rips across all bays. Extras wait as QUEUED for a free slot." Foreground="#8b93a8" FontSize="10" TextWrapping="Wrap" Margin="18,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="18,0,0,10">
                            <TextBlock Text="Max concurrent rips:" Foreground="#8b93a8" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="MaxConcurrentBox" Width="40" Background="#141b2d" Foreground="#e5e9f5" BorderBrush="#2a3550" Padding="4"/>
                        </StackPanel>

                        <Separator Margin="0,0,0,8"/>
                        <TextBlock Text="PLANNED — NOT YET BUILT" Foreground="#5b6478" FontWeight="Bold" FontSize="9" Margin="0,0,0,6"/>
                        <CheckBox Content="Cloud/NAS Mirror [Planned]" Foreground="#5b6478" IsEnabled="False" Margin="0,0,0,2"/>
                        <TextBlock Text="Auto-sync completed archives to a secondary backup location." Foreground="#5b6478" FontSize="10" TextWrapping="Wrap" Margin="18,0,0,0"/>
                    </StackPanel>
                </Expander>

                <TextBlock x:Name="MessageText" Foreground="#8b93a8" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"/>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,16">
            <Button x:Name="CancelButton" Content="Cancel" Width="90" Height="32" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button x:Name="SaveButton" Content="Save Preferences" Background="#10b981" Foreground="Black" Width="140" Height="32" FontWeight="Bold" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>