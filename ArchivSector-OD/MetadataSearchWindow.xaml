<Window x:Class="ArchivSector_OD.MetadataSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fetch Metadata &amp; Artwork"
        Height="600" Width="620"
        Background="#141b2d"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="SourceCombo" Grid.Column="0" Width="90" Margin="0,0,8,0" SelectionChanged="SourceCombo_SelectionChanged"/>
            <TextBox x:Name="QueryBox" Grid.Column="1" Background="#1b2438" Foreground="#e5e9f5" BorderBrush="#2a3550"
                     Padding="6" VerticalContentAlignment="Center" KeyDown="QueryBox_KeyDown"/>
            <Button x:Name="SearchButton" Grid.Column="2" Content="Search" Margin="8,0,0,0" Padding="10,4" Click="SearchButton_Click"/>
        </Grid>

        <ListBox Grid.Row="1" x:Name="ResultsList" Background="#1b2438" BorderBrush="#2a3550" BorderThickness="1"
                  SelectionChanged="ResultsList_SelectionChanged">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="6"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="#2a3550"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#22d3ee"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="{Binding ThumbnailUrl}" Width="50" Height="70" Stretch="UniformToFill" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="{Binding TitleWithYear}" Foreground="#e5e9f5" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Detail}" Foreground="#8b93a8" FontSize="10" TextWrapping="Wrap" MaxHeight="48" Margin="0,2,0,2"/>
                            <TextBlock Text="{Binding Source}" Foreground="#22d3ee" FontSize="9"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="2" Margin="0,8,0,0" FontSize="10" Foreground="#5b6478" TextWrapping="Wrap">
            <Run x:Name="AttributionPrefixRun" Text=""/>
            <Hyperlink x:Name="AttributionLink" Click="AttributionLink_Click" Foreground="#22d3ee">
                <Run x:Name="AttributionLinkRun" Text=""/>
            </Hyperlink>
        </TextBlock>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" Foreground="#8b93a8" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button Content="Cancel" Width="90" Height="32" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button x:Name="UseButton" Content="Use Selected" Background="#10b981" Foreground="Black" FontWeight="Bold" Width="120" Height="32" IsEnabled="False" Click="UseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>