<Window x:Class="ArchivSector_OD.MetadataSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fetch Metadata &amp; Artwork"
        Height="600" Width="620"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="SourceCombo" Grid.Column="0" Width="90" Margin="0,0,8,0" SelectionChanged="SourceCombo_SelectionChanged"/>
            <TextBox x:Name="QueryBox" Grid.Column="1"
                     Padding="6" VerticalContentAlignment="Center" KeyDown="QueryBox_KeyDown"/>
            <Button x:Name="SearchButton" Grid.Column="2" Content="🔍 Search" Style="{DynamicResource AccentButton}" Margin="8,0,0,0" Click="SearchButton_Click"/>
        </Grid>

        <ListBox ItemContainerStyle="{DynamicResource ThemeListItem}" Grid.Row="1" x:Name="ResultsList" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Edge}" BorderThickness="1"
                  SelectionChanged="ResultsList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="{Binding ThumbnailUrl}" Width="50" Height="70" Stretch="UniformToFill" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="{Binding TitleWithYear}" Foreground="{DynamicResource Text}" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="10" TextWrapping="Wrap" MaxHeight="48" Margin="0,2,0,2"/>
                            <TextBlock Text="{Binding Source}" Foreground="{DynamicResource Accent}" FontSize="9"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="2" Margin="0,8,0,0" FontSize="10" Foreground="{DynamicResource Muted}" TextWrapping="Wrap">
            <Run x:Name="AttributionPrefixRun" Text=""/>
            <Hyperlink x:Name="AttributionLink" Click="AttributionLink_Click" Foreground="{DynamicResource Accent}">
                <Run x:Name="AttributionLinkRun" Text=""/>
            </Hyperlink>
        </TextBlock>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button Content="Cancel" MinWidth="90" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button x:Name="UseButton" Content="Use Selected" Style="{DynamicResource SaveButton}" FontWeight="Bold" MinWidth="120" IsEnabled="False" Click="UseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>